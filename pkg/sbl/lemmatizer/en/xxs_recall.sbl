                'ening' 'epted' 'ereas' 'erts' 'estes' 'etics'
                'etts' 'evans' 'fazed' 'fing' 'fling' 'frans'
                'fred' 'fried' 'fuchs' 'gards' 'ggins' 'ggs'
                'ghes' 'giers' 'giles' 'glars' 'gned' 'gning'
                'going' 'goods' 'gprs' 'gps' 'grees' 'gts'
                'gules' 'hades' 'haels' 'hamed' 'haps' 'heses'
                'hilds' 'hines' 'hmed' 'hnuts' 'hodes' 'horst'
                'hted' 'iams' 'idps' 'ilmed' 'inted' 'irids'
                'is' 'isced' 'jared' 'javed' 'jeans' 'jes'
                'jikes' 'jing' 'jols' 'jones' 'js' 'judas'
                'jules' 'kans' 'kened' 'kins' 'kitts' 'ladys'
                'lbans' 'leeds' 'liged' 'lised' 'llabs' 'lles'
                'llins' 'llips' 'lmes' 'lming' 'loos' 'lours'
                'lsing' 'lways' 'mayed' 'mears' 'medes' 'mips'
                'mls' 'mmons' 'mms' 'mned' 'monds' 'mored'
                'moses' 'mpics' 'mrs' 'mts' 'mumps' 'myers'
                'mys' 'mzes' 'naked' 'ncest' 'ndes' 'ndres'
                'ndrew' 'news' 'nfs' 'ngals' 'nhs' 'nicks'
                'niels' 'nlcs' 'nnals' 'nnes' 'noirs' 'nolds'
                'nored' 'npaid' 'nseen' 'nthem' 'nucks' 'nused'
                'oakes' 'oases' 'obics' 'ocles' 'odest' 'oeing'
                'ogers' 'ohs' 'omics' 'onics' 'onors' 'orned'
                'os' 'oungs' 'oured' 'pcs' 'peres' 'plaid'
                'pls' 'poods' 'potts' 'pring' 'qing' 'rabs'
                'rared' 'rawls' 'rbed' 'rbes' 'rees' 'reyes'
                'rited' 'rles' 'rmes' 'rnes' 'rpens' 'rps'
                'rres' 'rrots' 'rseas' 'rtes' 'rthed' 'rzed'
                'sachs' 'saks' 'sars' 'sised' 'sled' 'ss'
                'stics' 'stoms' 'swing' 'sys' 'tairs' 'tgers'
                'thens' 'thews' 'thics' 'thing' 'tning' 'tokes'
                'trans' 'trics' 'tring' 'tsons' 'ucs' 'uined'
                'urdes' 'us' 'veled' 'vered' 'veted' 'vhs'
                'vives' 'vored' 'vres' 'vrts' 'vs' 'waals'
                'wajed' 'wards' 'weets' 'wens' 'wks' 'wles'
                'wnded' 'yces' 'yds' 'yes' 'ygens' 'yikes'
                'ynes' 'yping' 'ysics' 'ytics' 'yves' 'yways'
                'zores'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
