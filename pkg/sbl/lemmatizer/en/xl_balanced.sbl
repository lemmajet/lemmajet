                'watering' 'wdered' 'wders' 'wealthier' 'weathers' 'webs'
                'weed' 'weeping' 'weets' 'wetted' 'whats' 'wielded'
                'wielding' 'wields' 'willed' 'willing' 'wilted' 'windings'
                'winters' 'wits' 'witted' 'wittles' 'wkins' 'wles'
                'wlines' 'wnes' 'wns' 'woes' 'woking' 'wolds'
                'wonders' 'wpoints' 'wratings' 'wring' 'xampled' 'xans'
                'xerces' 'xerted' 'xerting' 'xerts' 'xides' 'xisting'
                'xists' 'xons' 'xpending' 'xported' 'xporting' 'xports'
                'xpounded' 'xsports' 'xtensions' 'xties' 'xulting' 'xuries'
                'yads' 'yans' 'yarning' 'yarns' 'yars' 'yces'
                'yches' 'yclades' 'yds' 'yeading' 'yed' 'yees'
                'ygone' 'ygons' 'ygues' 'yikes' 'yments' 'ymers'
                'ymes' 'ymiest' 'ynews' 'yoming' 'yphics' 'yping'
                'yrds' 'yrights' 'ysicians' 'ysses' 'ytelling' 'ything'
                'ytics' 'ytimes' 'yting' 'yves' 'yways' 'ywed'
                'ywheres' 'zales' 'zaras' 'zarded' 'zarks' 'zilians'
                'zjournals' 'zores' 'zsimons' 'zures'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
