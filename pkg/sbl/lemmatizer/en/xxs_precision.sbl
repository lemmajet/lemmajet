integers ( cutv )

booleans ( pfx_changed )

routines (
    exceptions
    strip_prefix
    strip_enclitics
    apply_suffix_trie
    normalize_tail
    op_0_1
    op_0_2
    op_0_3
    op_1_1
    op_1_2
    op_1_3
    op_1_4
    op_2_1
    op_2_3
)

externals ( lemmatize stem )

backwardmode (
    /* Stage 1: Suppletive / Irregular Exceptions Lookup */
    define exceptions as (
        [substring] atlimit among (
  'athens' (<- 'athens')
  'avoide' (<- 'avoid')
  'compet' (<- 'compete')
  'complet' (<- 'complete')
  'controll' (<- 'control')
  'developed' (<- 'develop')
  'during' (<- 'during')
  'focuse' (<- 'focus')
  'hange' (<- 'hang')
  'helped' (<- 'help')
  'her' (<- 'she')
  'holmes' (<- 'holmes')
  'leape' (<- 'leap')
  'looking' (<- 'look')
  'lower' (<- 'low')
  'perhaps' (<- 'perhaps')
  'reuters' (<- 'reuters')
  'ringe' (<- 'ring')
  'series' (<- 'series')
  'smil' (<- 'smile')
  'speaking' (<- 'speak')
  'species' (<- 'species')
  'themselves' (<- 'they')
  'welcom' (<- 'welcome')
  'your' (<- 'you')
        )
    )

    /* Stage 2b: Movable Enclitic Stripping */
    define strip_enclitics as (false)

    define op_0_1 as ($cutv = 1 set pfx_changed)
    define op_0_2 as ($cutv = 2 set pfx_changed)
    define op_0_3 as ($cutv = 3 set pfx_changed)
    define op_1_1 as (test next $cutv = 1 set pfx_changed)
    define op_1_2 as (test next $cutv = 2 set pfx_changed)
    define op_1_3 as (test next $cutv = 3 set pfx_changed)
    define op_1_4 as (test next $cutv = 4 set pfx_changed)
    define op_2_1 as (test hop 2 $cutv = 1 set pfx_changed)
    define op_2_3 as (test hop 2 $cutv = 3 set pfx_changed)

    /* Stage 3: Pruned Reversed Suffix-Trie CutAdd Transducer */
    define apply_suffix_trie as (
        $cutv = 0
        (
            [ test substring hop cutv ] among (
                'aided' op_0_2 'aited' op_0_2 'aken' op_0_1 'aled' op_0_2 'bbed' op_1_3 'bbing' op_1_4
                'bited' op_0_2 'buses' op_0_2 'cked' op_0_2 'cted' op_0_2 'dded' op_1_3 'dding' op_1_4
                'dest' op_1_3 'done' op_0_2 'drawn' op_0_1 'eaked' op_0_2 'eamed' op_0_2 'eared' op_0_2
                'eated' op_0_2 'ed' op_1_1 'eled' op_0_2 'elled' op_0_3 'emed' op_0_2 'ered' op_0_2
                'eted' op_0_2 'fed' op_1_2 'filed' op_0_1 'fined' op_0_1 'fted' op_0_2 'gged' op_1_3
                'gging' op_1_4 'gher' op_0_2 'hed' op_1_2 'hes' op_1_2 'htest' op_0_3 'iled' op_0_2
                'illas' op_0_1 'imed' op_0_2 'ing' op_2_3 'iven' op_0_1 'kest' op_1_3 'lded' op_0_2
                'lest' op_1_3 'lined' op_0_1 'lked' op_0_2 'lled' op_0_2 'lmed' op_0_2 'lted' op_0_2
                'mbed' op_0_2 'mined' op_0_1 'mmed' op_1_3 'mming' op_1_4 'mped' op_0_2 'nded' op_0_2
                'ned' op_1_2 'ngest' op_0_3 'nked' op_0_2 'nned' op_1_3 'nning' op_1_4 'nted' op_0_2
                'oaded' op_0_2 'oated' op_0_2 'oed' op_1_2 'oes' op_1_2 'omed' op_0_2 'onged' op_0_2
                'ooked' op_0_2 'ooled' op_0_2 'ooped' op_0_2 'ooted' op_0_2 'outed' op_0_2 'pped' op_1_3
                'pping' op_1_4 'pted' op_0_2 'rded' op_0_2 'rked' op_0_2 'rled' op_0_2 'rmed' op_0_2
                'rred' op_1_3 'rring' op_1_4 'rted' op_0_2 's' op_2_1 'sest' op_0_2 'shoes' op_0_1
                'sited' op_0_2 'sked' op_0_2 'sped' op_0_2 'ssed' op_0_2 'sses' op_0_2 'ssing' op_0_3
                'sted' op_0_2 'thes' op_0_1 'tted' op_1_3 'tting' op_1_4 'uned' op_0_1 'vies' op_0_1
                'wed' op_1_2 'wled' op_0_2 'xed' op_1_2 'xes' op_1_2 'yed' op_1_2
                    (delete)
                'men' op_0_2
                    (<- 'an')
                'aking' op_0_3 'aping' op_0_3 'ating' op_0_3 'bling' op_0_3 'cing' op_0_3 'cling' op_0_3
                'dling' op_0_3 'ging' op_0_3 'gling' op_0_3 'iding' op_0_3 'ining' op_0_3 'iping' op_0_3
                'iring' op_0_3 'kling' op_0_3 'oking' op_0_3 'oping' op_0_3 'oring' op_0_3 'oting' op_0_3
                'pling' op_0_3 'sing' op_0_3 'tling' op_0_3 'uding' op_0_3 'uing' op_0_3 'uling' op_0_3
                'uming' op_0_3 'uring' op_0_3 'ving' op_0_3 'zing' op_0_3
                    (<- 'e')
                'ied' op_1_3 'ies' op_1_3 'iest' op_1_4 'lier' op_0_3
                    (<- 'y')
                'aes' 'aired' 'andes' 'aos' 'arles' 'bring'
                'cbs' 'doned' 'dred' 'eaded' 'ected' 'eed'
                'eeded' 'ening' 'etics' 'fing' 'fred' 'gned'
                'hted' 'ias' 'is' 'jing' 'las' 'leeds'
                'lles' 'los' 'mas' 'mmons' 'monds' 'mpics'
                'mrs' 'naked' 'news' 'nics' 'oeing' 'oured'
                'rbed' 'rited' 'ss' 'texas' 'thing' 'us'
                'vered' 'vs' 'was'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
