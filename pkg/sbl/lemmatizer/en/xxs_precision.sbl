integers ( cutv )

booleans ( pfx_changed )

routines (
    exceptions
    strip_prefix
    strip_enclitics
    apply_suffix_trie
    normalize_tail
    op_0_1
    op_0_2
    op_0_3
    op_1_1
    op_1_2
    op_1_3
    op_1_4
    op_2_1
    op_2_3
    op_2_4
)

externals ( lemmatize stem )

backwardmode (
    /* Stage 1: Suppletive / Irregular Exceptions Lookup */
    define exceptions as (false)

    /* Stage 2b: Movable Enclitic Stripping */
    define strip_enclitics as (false)

    define op_0_1 as ($cutv = 1 set pfx_changed)
    define op_0_2 as ($cutv = 2 set pfx_changed)
    define op_0_3 as ($cutv = 3 set pfx_changed)
    define op_1_1 as (test next $cutv = 1 set pfx_changed)
    define op_1_2 as (test next $cutv = 2 set pfx_changed)
    define op_1_3 as (test next $cutv = 3 set pfx_changed)
    define op_1_4 as (test next $cutv = 4 set pfx_changed)
    define op_2_1 as (test hop 2 $cutv = 1 set pfx_changed)
    define op_2_3 as (test hop 2 $cutv = 3 set pfx_changed)
    define op_2_4 as (test hop 2 $cutv = 4 set pfx_changed)

    /* Stage 3: Pruned Reversed Suffix-Trie CutAdd Transducer */
    define apply_suffix_trie as (
        $cutv = 0
        (
            [ test substring hop cutv ] among (
                'aed' op_1_2 'aing' op_1_3 'ains' op_0_1 'aken' op_0_1 'aned' op_0_2 'aped' op_0_1
                'bbed' op_1_3 'been' op_0_2 'bing' op_2_4 'bins' op_0_1 'cons' op_0_1 'dded' op_1_3
                'dest' op_1_3 'ding' op_1_3 'does' op_0_2 'done' op_0_2 'ed' op_1_1 'eens' op_0_1
                'eggs' op_0_1 'eing' op_1_3 'eped' op_0_2 'ered' op_0_2 'eted' op_0_2 'fans' op_0_1
                'fed' op_1_2 'fins' op_0_1 'fted' op_0_2 'gans' op_0_1 'gged' op_1_3 'gher' op_0_2
                'gins' op_0_1 'goes' op_0_2 'gone' op_0_2 'gons' op_0_1 'hans' op_0_1 'hed' op_1_2
                'hes' op_1_2 'hest' op_1_3 'hing' op_1_3 'hins' op_0_1 'ibed' op_0_1 'iing' op_1_3
                'iked' op_0_1 'iled' op_0_2 'iped' op_0_1 'isen' op_0_1 'iven' op_0_1 'ked' op_1_2
                'kest' op_1_3 'kies' op_0_1 'king' op_1_3 'lded' op_0_2 'leas' op_0_1 'lled' op_0_2
                'lped' op_0_2 'lted' op_0_2 'mans' op_0_1 'mbed' op_0_2 'mmed' op_1_3 'mons' op_0_1
                'mped' op_0_2 'nned' op_1_3 'nted' op_0_2 'oans' op_0_1 'oed' op_1_2 'oing' op_1_3
                'omed' op_0_2 'oons' op_0_1 'oped' op_0_2 'otos' op_0_1 'oyed' op_0_2 'pans' op_0_1
                'ped' op_2_3 'ping' op_1_3 'pins' op_0_1 'pons' op_0_1 'rawn' op_0_1 'rded' op_0_2
                'rled' op_0_2 'rns' op_0_1 'rred' op_1_3 'rted' op_0_2 's' op_2_1 'sans' op_0_1
                'seen' op_0_1 'sins' op_0_1 'sped' op_0_2 'ssed' op_0_2 'sses' op_0_2 'thes' op_0_1
                'tons' op_0_1 'tted' op_1_3 'uins' op_0_1 'uns' op_0_1 'uped' op_0_2 'wed' op_1_2
                'were' op_0_1 'whom' op_0_1 'wing' op_1_3 'wins' op_0_1 'wled' op_0_2 'xed' op_1_2
                'xes' op_1_2 'xing' op_1_3 'ying' op_1_3 'yons' op_0_1 'your' op_0_1 'yped' op_0_1
                    (delete)
                'took' op_0_3
                    (<- 'ake')
                'tood' op_0_3
                    (<- 'and')
                'ing' op_1_3
                    (<- 'e')
                'oken' op_1_4
                    (<- 'eak')
                'got' op_0_2
                    (<- 'et')
                'held' op_0_3
                    (<- 'old')
                'came' op_0_3
                    (<- 'ome')
                'ied' op_1_3 'ies' op_1_3 'iest' op_1_4 'lier' op_0_3 'said' op_0_2
                    (<- 'y')
                'aels' 'afts' 'aled' 'aos' 'as' 'auds'
                'bbs' 'bed' 'bms' 'boks' 'bted' 'bts'
                'cbs' 'cds' 'ceed' 'chs' 'cies' 'cted'
                'cts' 'days' 'deed' 'dos' 'dows' 'dred'
                'dys' 'eded' 'eems' 'efs' 'eled' 'ened'
                'eos' 'ests' 'etts' 'fing' 'firs' 'fred'
                'ggs' 'ghes' 'gned' 'gos' 'gths' 'hbos'
                'heed' 'hms' 'hos' 'hted' 'hts' 'iams'
                'ikos' 'ilms' 'ioms' 'ipos' 'irms' 'is'
                'ited' 'jing' 'joys' 'lays' 'lles' 'lmed'
                'lmes' 'los' 'mphs' 'mrs' 'ncs' 'nded'
                'need' 'news' 'nics' 'ning' 'nnes' 'nors'
                'nos' 'ns' 'nys' 'ofs' 'olks' 'oned'
                'oods' 'opts' 'oros' 'orts' 'ours' 'peed'
                'pted' 'pths' 'rits' 'rlds' 'rles' 'rmed'
                'rmes' 'rned' 'rped' 'rtes' 'rys' 'seed'
                'ss' 'sted' 'sys' 'ties' 'tos' 'ums'
                'urks' 'us' 'uths' 'vors' 'vs' 'wits'
                'wned' 'woes' 'yed' 'yees'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
