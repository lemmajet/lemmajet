                'ken' 'lejos' 'lme' 'men' 'mitad' 'nana'
                'nen{u00e9}' 'onle' 'orme' 'orqu{u00e9}' 'orte' 'or{u00e1}n'
                'os{u00e9}' 'pat{u00ed}a' 'pa{u00ed}s' 'plan' 'prado' 'psida'
                'pues' 'quiz{u00e1}' 'rc{u00e9}s' 'rden' 'rendo' 'ronme'
                'ruido' 'san' 'sean' 'sede' 'solo' 'tion'
                'tr{u00e1}s' 'uan' 'uando' 'uerte' 'uiera' 'ume'
                'unes' 'ven' 'vos' 'v{u00e9}s' 'wan' 'ware'
                'wen' '{u00e1}cido' '{u00e1}mara' '{u00e1}mica' '{u00e9}rica' '{u00ed}mica'
                '{u00ed}sica' '{u00f3}me'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
