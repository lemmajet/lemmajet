                'riva' 'rivas' 'ri{u00f3}' 'ri{u00f3}se' 'rj{u00e9}' 'rofos'
                'roman' 'ronlo' 'ronme' 'rosen' 'rqu{u00e9}' 'rqu{u00e9}s'
                'rtran' 'ruido' 'ruman' 'sagan' 'san' 'sara'
                'satan' 'scada' 'scido' 'sean' 'secta' 'sede'
                'siado' 'sida' 'sima' 'sipes' 'sits' 'si{u00e1}'
                'snare' 'soren' 'spada' 'spira' 'squea' 'sres'
                'ssad' 'ssen' 'ssion' 'ss{u00f3}' 'stead' 'susan'
                'taba' 'tara' 'tea' 'tebas' 'tedes' 'ten'
                'tern{u00e1}' 'tern{u00e9}' 'ter{u00e9}s' 'tiza' 'tlan' 'tlas'
                'tles' 'tman' 'toh{u00e1}' 'tonga' 'tor{u00e1}' 'traba'
                'trad' 'trece' 'tren' 'tr{u00e1}s' 'ttan' 'tulu{u00e1}'
                'tuya' 'tzit{u00e9}' 't{u00e9}' 't{u00ed}' 't{u00ed}a' 'uan'
                'uando' 'udi{u00f3}' 'ueen' 'uerte' 'ueves' 'uglas'
                'uiera' 'uiles' 'uiz{u00e1}' 'uiz{u00e1}s' 'ukos' 'ules'
                'unare' 'unes' 'unsen' 'untad' 'urban' 'urg{u00e9}s'
                'uribe' 'uron' 'urre' 'uslo' 'uste' 'ust{u00e9}'
                'uzco' 'vais' 'vayas' 'ven' 'veras' 'vida'
                'viese' 'voac{u00e9}' 'vogue' 'v{u00e9}s' 'wales' 'wan'
                'ware' 'wen' 'xas' 'xido' 'yaj{u00e1}' 'yale'
                'yan' 'yanes' 'yarid' 'yazi{u00e9}' 'yenn{u00e9}' 'yepes'
                'yijad' 'ynes' 'yros' 'yves' 'y{u00e9}' 'zari{u00e1}'
                'zen' 'zida' '{u00e1}bado' '{u00e1}bana' '{u00e1}cido' '{u00e1}es'
                '{u00e1}mara' '{u00e1}nos' '{u00e1}rido' '{u00e1}vido' '{u00e9}rase' '{u00e9}rida'
                '{u00ed}ades' '{u00ed}dolo' '{u00ed}gado' '{u00ed}gido' '{u00ed}jele' '{u00ed}laba'
                '{u00ed}mite' '{u00ed}vido' '{u00f3}les' '{u00f3}sele' '{u00f3}selo'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
