                '{u017e}iv{u016f}tku' '{u017e}i{u010d}e' '{u017e}lany' '{u017e}li' '{u017e}loutek' '{u017e}mem'
                '{u017e}m{u00e1}' '{u017e}ongl{u00e9}{u0159}i' '{u017e}ou' '{u017e}ovska' '{u017e}ovsk{u00e1}' '{u017e}tky'
                '{u017e}u' '{u017e}unovi' '{u017e}upan{u00e9}' '{u017e}{u00e1}dn{u00ed}kov{u00e1}' '{u017e}{u00e1}n' '{u017e}{u00e1}na'
                '{u017e}{u00e1}ni' '{u017e}{u00e1}rnou' '{u017e}{u00e1}zan{u00e9}' '{u017e}{u00ed}h{u00e1}' '{u017e}{u00ed}nku' '{u017e}{u00ed}ny'
                '{u017e}{u00ed}n{u011b}' '{u017e}{u00ed}vaj{u00ed}ce' '{u017e}{u00ed}{u0161}' '{u017e}{u010f}any'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
