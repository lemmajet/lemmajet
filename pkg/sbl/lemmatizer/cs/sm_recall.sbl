                '{u017e}{u00ed}h{u00e1}' '{u017e}{u00ed}nku' '{u017e}{u00ed}ny' '{u017e}{u00ed}n{u011b}' '{u017e}{u010f}any' '{u017e}{u0161}{u00ed}mi'
