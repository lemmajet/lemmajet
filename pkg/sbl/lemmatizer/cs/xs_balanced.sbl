                't{u00e9}ka' 't{u00e9}ku' 't{u00e9}k{u016f}' 't{u00fd}ny' 't{u00fd}ra' 't{u00fd}ry'
                't{u011b}j{u016f}' 't{u0159}in' 't{u016f}ni' 'ubk{u016f}' 'uede' 'uh{u016f}m'
                'ulzy' 'um{u00e1}m' 'upko' 'ursa' 'usl{u00ed}' 'u{u010d}at'
