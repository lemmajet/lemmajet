                'y{u0159}i' 'zadu' 'zad{u00ed}' 'zaj{u00ed}c' 'zav{u0161}e' 'zdali'
                'zdech' 'zdena' 'zdory' 'zlat{u00e1}' 'zlo' 'zmije'
                'zmoci' 'zmou' 'znaj{u00ed}' 'zn{u00e1}te' 'zprvu' 'zsky'
                'zzy' 'z{u00e1}' 'z{u00e1}hy' 'z{u00e1}pal' 'z{u00e9}' '{u00e1}dac{u00ed}'
                '{u00e1}dech' '{u00e1}jem' '{u00e1}j{u00ed}' '{u00e1}kov{u00e1}' '{u00e1}l{u00e1}' '{u00e1}ska'
                '{u00e9}ci' '{u00e9}la' '{u00e9}tech' '{u00ed}je' '{u00ed}jem' '{u00ed}la'
                '{u00ed}mac{u00ed}' '{u00ed}tac{u00ed}' '{u00fa}d{u011b}l' '{u00fa}kryt' '{u00fa}pat{u00ed}' '{u00fa}ti'
                '{u010d}eho' '{u010d}en' '{u010d}inek' '{u010d}kov{u00e1}' '{u010d}ou' '{u010d}sti'
                '{u011b}jiny' '{u011b}ky' '{u011b}rou' '{u011b}st{u00ed}' '{u011b}tlo' '{u011b}{u017e}ce'
                '{u0148}al' '{u0148}{u016f}m' '{u0159}edem' '{u0159}edu' '{u0159}ej{u00ed}' '{u0159}ekne'
                '{u0159}ov{u00e1}' '{u0159}sky' '{u0159}{u00ed}ci' '{u0159}{u00ed}m' '{u0161}aty' '{u0161}elmy'
                '{u0161}en' '{u0161}kov{u00e1}' '{u0161}ov{u00e1}' '{u0161}t{u011b}n{u011b}' '{u0161}{u00ed}ch' '{u0161}{u00ed}ho'
                '{u0161}{u00ed}m' '{u0161}{u00ed}mi' '{u0161}{u00ed}mu' '{u0165}al' '{u016f}li' '{u016f}{u017e}em'
                '{u017e}al' '{u017e}dy' '{u017e}el' '{u017e}ena' '{u017e}li' '{u017e}m{u00e1}'
                '{u017e}ou' '{u017e}u'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
