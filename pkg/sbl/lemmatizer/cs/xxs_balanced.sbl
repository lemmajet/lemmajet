  '{u00ed}dr{u016f}m' (false)
  '{u00ed}jeli' (false)
  '{u00ed}nami' (false)
  '{u00ed}n{u00e1}m' (false)
  '{u00ed}v{u00e1}no' (false)
  '{u00fd}daj{u016f}' (false)
  '{u00fd}m{u011b}nu' (false)
  '{u00fd}vozu' (false)
  '{u0148}kami' (false)
  '{u016f}m{u011b}ru' (false)
  '{u016f}razu' (false)
  '{u017e}ov{u00e1}n' (false)
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
