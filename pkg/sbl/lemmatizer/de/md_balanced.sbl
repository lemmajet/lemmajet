                '{u00f6}sste' '{u00f6}ssten' '{u00f6}sster' '{u00f6}{u00df}tem' '{u00fc}bers' '{u00fc}chtert'
                '{u00fc}ckert' '{u00fc}diger' '{u00fc}gbaren' '{u00fc}gbarer' '{u00fc}gbares' '{u00fc}hrtes'
                '{u00fc}ldene' '{u00fc}ldenen' '{u00fc}ltige' '{u00fc}ltiges' '{u00fc}mpeln' '{u00fc}mt'
                '{u00fc}nchens' '{u00fc}ndiger' '{u00fc}ngst' '{u00fc}nnige' '{u00fc}rers' '{u00fc}rgriff'
                '{u00fc}ringe' '{u00fc}rtels' '{u00fc}ssels' '{u00fc}st' '{u00fc}te' '{u00fc}tert'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
