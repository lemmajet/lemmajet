                'its' 'jetzt' 'kern' 'kles' 'kret' 'kunde'
                'lege' 'lert' 'lfte' 'locke' 'lpen' 'lten'
                'l{u00e4}nde' 'l{u00e4}nge' 'l{u00fc}cke' 'marke' 'mate' 'mitte'
                'mmeln' 'ndert' 'nemen' 'note' 'olen' 'onds'
                'onem' 'ones' 'orks' 'osten' 'paren' 'peln'
                'pert' 'pes' 'pitze' 'pten' 'rate' 'reten'
                'riede' 'rles' 'rolle' 'runde' 'rzt' 'r{u00fc}cke'
                'salem' 'sechs' 'seele' 'site' 'sorte' 'sseln'
                'stem' 'stens' 'summe' 'tante' 'timme' 'trend'
                'tte' 'tunde' 'ules' 'unten' 'uote' 'ures'
                'urs' 'usend' 'usst' 'wende' 'wert' 'wet'
                'wu{u00df}t' 'yes' 'ynes' 'yrien' 'yte' 'ytten'
                '{u00df}te' '{u00e4}chst' '{u00e4}hlen' '{u00e4}rke' '{u00e4}rmen' '{u00e4}rts'
                '{u00e4}rzte' '{u00f6}te' '{u00f6}ten' '{u00fc}llen' '{u00fc}rzen' '{u00fc}ste'
                '{u00fc}te' '{u00fc}ten' '{u00fc}tze'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
