                '{u00e4}ses' '{u00e4}sterer' '{u00e4}therische' '{u00e4}tschern' '{u00e4}ttigen' '{u00e4}uchern'
                '{u00e4}uern' '{u00e4}ugeln' '{u00e4}unen' '{u00e4}useln' '{u00e4}uten' '{u00e4}utern'
                '{u00e4}yerischen' '{u00e4}ys' '{u00f6}bern' '{u00f6}chst' '{u00f6}ckeln' '{u00f6}ffe'
                '{u00f6}fter' '{u00f6}ftern' '{u00f6}genden' '{u00f6}gern' '{u00f6}len' '{u00f6}nden'
                '{u00f6}nl{u00e4}nder' '{u00f6}nniges' '{u00f6}ns' '{u00f6}pfeln' '{u00f6}rdens' '{u00f6}rderst'
                '{u00f6}rlose' '{u00f6}rres' '{u00f6}rs' '{u00f6}s' '{u00f6}scher' '{u00f6}steln'
                '{u00f6}stigen' '{u00f6}te' '{u00f6}ten' '{u00f6}thigt' '{u00f6}tteln' '{u00f6}ttiger'
                '{u00f6}tze' '{u00f6}{u00df}ern' '{u00fc}bert{u00f6}nen' '{u00fc}brigents' '{u00fc}bs' '{u00fc}chten'
                '{u00fc}chtern' '{u00fc}chtet' '{u00fc}ckeln' '{u00fc}ckert' '{u00fc}det' '{u00fc}diger'
                '{u00fc}dl{u00e4}nder' '{u00fc}end' '{u00fc}ffeln' '{u00fc}fte' '{u00fc}geleisen' '{u00fc}hern'
                '{u00fc}hlen' '{u00fc}hlicht' '{u00fc}hmt' '{u00fc}hst{u00fc}cken' '{u00fc}llen' '{u00fc}lpen'
                '{u00fc}lste' '{u00fc}mme' '{u00fc}mmeln' '{u00fc}mmern' '{u00fc}mmt' '{u00fc}mt'
                '{u00fc}ndeln' '{u00fc}ndelt' '{u00fc}nden' '{u00fc}ndert' '{u00fc}ndeter' '{u00fc}nds'
                '{u00fc}ndten' '{u00fc}ngst' '{u00fc}nkern' '{u00fc}ns' '{u00fc}rchten' '{u00fc}rgenommen'
                '{u00fc}rgriff' '{u00fc}richs' '{u00fc}ringe' '{u00fc}rnen' '{u00fc}rste' '{u00fc}rzen'
                '{u00fc}s' '{u00fc}ste' '{u00fc}te' '{u00fc}ten' '{u00fc}tert' '{u00fc}tigt'
                '{u00fc}tteln' '{u00fc}tze'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
