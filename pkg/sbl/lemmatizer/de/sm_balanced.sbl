                'adas' op_0_1 'adende' op_0_1 'adern' op_0_1 'adeter' op_0_2 'adiern' op_0_1 'adiese' op_0_1
                'adine' op_0_1 'adows' op_0_1 'aeten' op_0_2 'affene' op_0_3 'afis' op_0_1 'aftens' op_0_3
                'afters' op_0_1 'agere' op_0_1 'ageren' op_0_2 'aggen' op_0_1 'agiles' op_0_2 'agnen' op_0_1
                'agnete' op_0_1 'agone' op_0_1 'agras' op_0_1 'ahre' op_0_1 'ahrem' op_0_2 'ahus' op_0_1
                'aien' op_1_2 'aignen' op_0_1 'ailten' op_0_2 'airem' op_0_2 'airen' op_0_2 'airer' op_0_2
                'aiten' op_0_1 'aitis' op_0_1 'aive' op_0_1 'aiven' op_0_2 'aiver' op_0_2 'akern' op_0_1
                'aktere' op_0_1 'alanen' op_0_1 'alaste' op_0_1 'albs' op_0_1 'albt' op_0_1 'aldete' op_0_1
