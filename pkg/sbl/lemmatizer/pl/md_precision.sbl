        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}m' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
