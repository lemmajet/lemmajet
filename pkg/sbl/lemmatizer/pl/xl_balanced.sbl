                '{u0119}za' '{u0119}zy' '{u0119}{u015b}cie' '{u0119}{u017c}ki' '{u0119}{u017c}yc' '{u0142}acalny'
                '{u0142}acz{u0105}cego' '{u0142}ada' '{u0142}adowo' '{u0142}agisza' '{u0142}ag{u00f3}w' '{u0142}ahy'
                '{u0142}ajki' '{u0142}ajno' '{u0142}akomam' '{u0142}akowa' '{u0142}akowska' '{u0142}askawi{u0142}'
                '{u0142}asko' '{u0142}atwy' '{u0142}awek' '{u0142}awice' '{u0142}azarenko' '{u0142}a{u0142}'
                '{u0142}dowo' '{u0142}ednie' '{u0142}enko' '{u0142}eonid' '{u0142}esia' '{u0142}kany'
