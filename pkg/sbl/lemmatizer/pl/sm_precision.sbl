                '{u00f3}dzi' '{u00f3}d{u0119}' '{u00f3}d{u017a}' '{u00f3}lowa' '{u00f3}tce' '{u00f3}tki'
                '{u00f3}ty' '{u00f3}winy' '{u00f3}wna' '{u00f3}{u0142}' '{u00f3}{u0142}ty' '{u00f3}{u017c}no'
                '{u0105}bie' '{u0105}cze' '{u0105}drze' '{u0105}d{u017a}' '{u0105}g{u0142}y' '{u0105}trzu'
                '{u0105}ty' '{u0107}ennaj' '{u0107}kie' '{u0107}kim' '{u0107}pani' '{u0119}bacz'
                '{u0119}baku' '{u0119}boki' '{u0119}cem' '{u0119}cim' '{u0119}cy' '{u0119}dce'
                '{u0119}dy' '{u0119}dzie' '{u0119}dzy' '{u0119}giem' '{u0119}sa' '{u0119}zy'
                '{u0119}{u015b}cie' '{u0119}{u017c}ki' '{u0142}abowa' '{u0142}adnia' '{u0142}adowo' '{u0142}ag{u00f3}w'
                '{u0142}aj' '{u0142}ajno' '{u0142}a{u0142}' '{u0142}ednie' '{u0142}kany' '{u0142}maty'
                '{u0142}ochy' '{u0142}odu' '{u0142}ody' '{u0142}omie{u0144}' '{u0142}om{u017c}a' '{u0142}ona'
                '{u0142}onko' '{u0142}ono' '{u0142}osi' '{u0142}owo' '{u0142}tora' '{u0142}ukasz'
                '{u0142}upi' '{u0142}ysy' '{u0142}yta' '{u0142}{u0119}czna' '{u0142}{u0142}' '{u0142}{u0142}a'
                '{u0142}{u0142}y' '{u0142}{u017c}eby{u015b}' '{u0144}cza' '{u0144}ku' '{u015b}cig{u0142}e' '{u015b}lepie'
                '{u015b}lepy' '{u015b}l{u0105}' '{u015b}mia{u0142}o' '{u015b}miele' '{u015b}mig{u0142}y' '{u015b}reb{u0142}a'
                '{u015b}wieca' '{u015b}wie{u017c}y' '{u017a}ra{u0142}ym' '{u017c}aga{u0144}' '{u017c}ci' '{u017c}dy'
                '{u017c}ejki' '{u017c}elech' '{u017c}eli' '{u017c}erd{u017a}' '{u017c}etysu' '{u017c}mija'
                '{u017c}onaty' '{u017c}rej' '{u017c}uraw' '{u017c}{u0105}dza'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'naj{u015b}p' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebi' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'nieb{u0105}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}m' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
