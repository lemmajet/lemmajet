                'zys{u0142}{u00f3}w' 'zyta' 'zywna' 'zywy' 'zyzie' 'zy{u0142}u'
                'zy{u0144}ca' 'zy{u015b}cie' 'zy{u017c}ki' 'zy{u017c}yny' 'zza' 'zzane'
                'zzy' 'z{u00f3}dki' 'z{u00f3}zka' 'z{u00f3}{u0142}ek' 'z{u0119}bi' 'z{u0119}dy'
                'z{u0119}g{u0142}o' 'z{u0142}adzi' 'z{u0142}o' 'z{u0142}om' 'z{u0142}oty' 'z{u0142}y'
                '{u00f3}bsko' '{u00f3}cznia' '{u00f3}dka' '{u00f3}dy' '{u00f3}dzi' '{u00f3}d{u0119}'
                '{u00f3}d{u017a}' '{u00f3}lowa' '{u00f3}rzany' '{u00f3}szmy' '{u00f3}tce' '{u00f3}tki'
                '{u00f3}tnia' '{u00f3}towo' '{u00f3}ty' '{u00f3}winy' '{u00f3}wna' '{u00f3}zef{u00f3}w'
                '{u00f3}{u0142}' '{u00f3}{u0142}owie' '{u00f3}{u0142}tawy' '{u00f3}{u0142}ty' '{u00f3}{u017c}any' '{u00f3}{u017c}no'
                '{u00f3}{u017c}owo' '{u0105}bie' '{u0105}ciu' '{u0105}cze' '{u0105}cz{u0119}ta' '{u0105}drze'
                '{u0105}galny' '{u0105}gowo' '{u0105}g{u0142}y' '{u0105}py' '{u0105}sko' '{u0105}trzu'
                '{u0105}t{u0142}y' '{u0105}{u017c}c{u00f3}w' '{u0107}kie' '{u0107}kiemu' '{u0107}kim' '{u0107}nych'
                '{u0107}pani' '{u0107}wik{u0142}a' '{u0107}{u017c}em' '{u0119}bacz' '{u0119}baku' '{u0119}bi{u00f3}w'
                '{u0119}bkiem' '{u0119}boki' '{u0119}cem' '{u0119}cim' '{u0119}ciwa' '{u0119}cy'
                '{u0119}dce' '{u0119}dzie' '{u0119}dziny' '{u0119}giem' '{u0119}kart' '{u0119}katy'
                '{u0119}kaw' '{u0119}na' '{u0119}pca' '{u0119}sa' '{u0119}sa{u0142}y' '{u0119}sie{u0144}'
                '{u0119}sim' '{u0119}sknie' '{u0119}sko' '{u0119}za' '{u0119}zy' '{u0119}{u015b}cie'
                '{u0119}{u017c}ki' '{u0142}ada' '{u0142}adka' '{u0142}adnia' '{u0142}ag{u00f3}w' '{u0142}ajki'
                '{u0142}ajno' '{u0142}akowa' '{u0142}aska' '{u0142}atwy' '{u0142}awek' '{u0142}awice'
                '{u0142}a{u0142}' '{u0142}ednie' '{u0142}enko' '{u0142}eonid' '{u0142}esia' '{u0142}kany'
                '{u0142}maty' '{u0142}ochy' '{u0142}och{u00f3}w' '{u0142}ocko' '{u0142}oczne' '{u0142}odnia'
                '{u0142}odu' '{u0142}omie{u0144}' '{u0142}omi{u0119}' '{u0142}omi{u0142}' '{u0142}omka' '{u0142}ona'
                '{u0142}oni' '{u0142}onko' '{u0142}onowo' '{u0142}opata' '{u0142}opi{u0119}' '{u0142}osi'
                '{u0142}os{u0105}' '{u0142}owo' '{u0142}o{u017c}na' '{u0142}rocze' '{u0142}ubna' '{u0142}ucisz'
                '{u0142}ud{u00f3}w' '{u0142}ukasz' '{u0142}upnia' '{u0142}usy' '{u0142}ycia' '{u0142}ydka'
                '{u0142}ystek' '{u0142}ysuli' '{u0142}ysy' '{u0142}yta' '{u0142}y{u015b}ni{u0105}' '{u0142}za'
                '{u0142}zawy' '{u0142}{u00f3}wek' '{u0142}{u00f3}wko' '{u0142}{u0119}czna' '{u0142}{u0142}' '{u0142}{u0142}a'
                '{u0142}{u0142}y' '{u0142}{u017c}eby{u015b}' '{u0144}cie{u017c}e' '{u0144}cza' '{u0144}cz{u00f3}w' '{u0144}kiem'
                '{u0144}kowi' '{u0144}ku' '{u015b}cu' '{u015b}kni{u0142}y' '{u015b}liby' '{u015b}lozy'
                '{u015b}l{u0105}' '{u015b}l{u0119}{u017c}a' '{u015b}mian' '{u015b}mia{u0142}o' '{u015b}miele' '{u015b}mi{u0119}'
                '{u015b}pa{u015b}na' '{u015b}piwa' '{u015b}rem' '{u015b}tuj{u0105}c' '{u015b}tuk{u0119}' '{u015b}wida'
                '{u015b}wieca' '{u015b}wie{u017c}y' '{u015b}winna' '{u017a}d{u017a}' '{u017a}ni{u0119}ta' '{u017a}rebk{u0119}'
                '{u017a}rza{u0142}y' '{u017c}a' '{u017c}aga{u0144}' '{u017c}anach' '{u017c}bi{u0105}c' '{u017c}cami'
                '{u017c}ci' '{u017c}dy' '{u017c}eczko' '{u017c}ejki' '{u017c}eliby' '{u017c}erd{u017a}'
                '{u017c}im' '{u017c}kowie' '{u017c}li' '{u017c}mija' '{u017c}omi' '{u017c}onaty'
                '{u017c}ory' '{u017c}rej' '{u017c}usi' '{u017c}ycko' '{u017c}ywy' '{u017c}yzny'
                '{u017c}{u0105}dza' '{u017c}{u0142}opa'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'naj{u015b}p' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebi' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'nieb{u0105}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}m' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
