                '{u015b}lacht{u0105}' '{u015b}lem' '{u015b}lepie' '{u015b}lepy' '{u015b}licka' '{u015b}lipie'
                '{u015b}mian' '{u015b}nie' '{u015b}nisk{u00f3}w' '{u015b}rem' '{u015b}trafu' '{u015b}wie{u017c}y'
                '{u015b}win{u0105}' '{u015b}{u0144}' '{u017a}d{u017a}' '{u017a}miem' '{u017a}ni{u0119}ta' '{u017a}no'
                '{u017a}{u0144}' '{u017c}aga{u0144}' '{u017c}anach' '{u017c}anowa' '{u017c}arna' '{u017c}awca'
                '{u017c}cami' '{u017c}ci' '{u017c}dy' '{u017c}ebry' '{u017c}eczko' '{u017c}erd{u017a}'
                '{u017c}e{u0142}' '{u017c}i' '{u017c}imowym' '{u017c}kowa' '{u017c}ko{u015b}ci' '{u017c}li'
                '{u017c}mija' '{u017c}nie' '{u017c}odzino' '{u017c}omi' '{u017c}onaty' '{u017c}ory'
                '{u017c}o{u0142}ynia' '{u017c}rej' '{u017c}ukowo' '{u017c}usi' '{u017c}wawo' '{u017c}yce'
                '{u017c}ychy' '{u017c}yjem' '{u017c}yki' '{u017c}ysko' '{u017c}ywy' '{u017c}yzny'
                '{u017c}{u0105}dza' '{u017c}{u0119}cy' '{u017c}{u0119}ty' '{u017c}{u0142}opa'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
