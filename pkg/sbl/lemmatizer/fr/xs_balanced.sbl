                'thiers' 'th{u00e8}bes' 'th{u00e9}' 'th{u00e9}e' 'th{u00e9}s{u00e9}e' 'tinent'
                'ti{u00e9}' 'tortue' 'trans' 'trente' 'troupe' 'troyes'
                'ts{u00e9}' 'tts' 'ud{u00e9}e' 'uens' 'ufs' 'uise'
                'uisse' 'ujours' 'ulysse' 'unas' 'unches' 'unds'
                'unques' 'urde' 'urment' 'urtant' 'us' 'vall{u00e9}e'
                'vante' 'vastes' 'vend{u00e9}e' 'venise' 'ventre' 'verrez'
                'vers' 'villa' 'vita' 'vivres' 'vosges' 'vrai'
                'vulez' 'want' 'wards' 'wiles' 'ws' 'xante'
                'xas' 'xelles' 'xilai' 'yc{u00e9}e' 'ys' 'yvains'
                'yves' 'z{u00e9}' '{u00e2}g{u00e9}' '{u00e8}che' '{u00e8}s' '{u00e9}ant'
                '{u00e9}dent' '{u00e9}g{u00e9}e' '{u00e9}lai' '{u00e9}lis{u00e9}e' '{u00e9}norme' '{u00e9}n{u00e9}e'
                '{u00e9}n{u00e9}es' '{u00e9}pais' '{u00e9}pop{u00e9}e' '{u00e9}p{u00e9}e' '{u00e9}quent' '{u00e9}rend'
                '{u00e9}rent' '{u00e9}sent' '{u00e9}ta' '{u00e9}t{u00e9}' '{u00e9}viens' '{u00e9}v{u00ea}ch{u00e9}'
                '{u00ef}as' '{u00ef}bes' '{u00ef}s' '{u00f4}s' '{u00f4}t{u00e9}' '{u00fc}es'
                '{u00fc}s' '{u0153}urs'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
