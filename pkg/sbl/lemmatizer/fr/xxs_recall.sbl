                'ud{u00e9}e' 'uens' 'uers' 'ufs' 'ugues' 'uhait'
                'uin{u00e9}e' 'uise' 'uisse' 'ult{u00e9}' 'umas' 'unas'
                'undra' 'unds' 'unkes' 'upt{u00e9}' 'upure' 'ura'
                'us' 'uss{u00e9}e' 'vache' 'value' 'vans' 'vante'
                'vens' 'vers' 'verve' 'vesta' 'vet{u00e9}' 'vexe'
                'vista' 'vita' 'vol{u00e9}e' 'voute' 'vulez' 'v{u00e9}ens'
                'v{u00ea}ch{u00e9}' 'v{u00ee}mes' 'v{u00ee}tes' 'want' 'wards' 'wars'
                'wiles' 'wise' 'wls' 'worms' 'ws' 'xante'
                'xas' 'xixe' 'xtra' 'yahv{u00e9}' 'yale' 'yalta'
                'yc{u00e9}e' 'yonez' 'ys' 'yss{u00e9}e' 'ytals' 'yves'
                'zar{u00e9}' 'zins' 'z{u00e9}' '{u00e2}g{u00e9}' '{u00e2}ques' '{u00e7}oise'
                '{u00e8}bes' '{u00e8}s' '{u00e9}ant' '{u00e9}b{u00e9}' '{u00e9}g{u00e9}e' '{u00e9}l{u00e9}e'
                '{u00e9}m{u00e9}e' '{u00e9}n{u00e9}e' '{u00e9}n{u00e9}es' '{u00e9}pais' '{u00e9}pars' '{u00e9}p{u00e9}e'
                '{u00e9}rend' '{u00e9}rent' '{u00e9}s{u00e9}e' '{u00e9}ta' '{u00e9}tent' '{u00e9}t{u00e9}'
                '{u00ef}as' '{u00ef}bes' '{u00ef}s' '{u00ef}t{u00e9}' '{u00f4}s' '{u00f4}t{u00e9}'
                '{u00fb}ches' '{u00fb}lant' '{u00fc}es' '{u00fc}s' '{u0153}uds' '{u0153}urs'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
