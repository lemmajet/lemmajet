                'uriles' 'urment' 'urnaise' 'uroient' 'urrent' 'urtant'
                'us' 'usit{u00e9}e' 'usit{u00e9}es' 'usit{u00e9}s' 'uss{u00e9}e' 'utrice'
                'uvente' 'vacarme' 'vache' 'valdez' 'valenti' 'vallez'
                'vall{u00e9}e' 'value' 'vampire' 'vanc{u00e9}e' 'vans' 'vante'
                'vanves' 'vasquez' 'vastes' 'veisse' 'veltres' 'vend{u00e9}e'
                'vens' 'ventre' 'vercors' 'verrez' 'verriez' 'verrons'
                'vers' 'verve' 'vervins' 'vesta' 'vestue' 'vet{u00e9}'
                'vexe' 'vicente' 'vieques' 'vierse' 'villars' 'villers'
                'vincent' 'vista' 'vita' 'vivres' 'voldra' 'voldrai'
                'volques' 'volunt{u00e9}' 'vol{u00e9}e' 'voute' 'vs' 'vulez'
                'v{u00e9}ens' 'v{u00ea}ch{u00e9}' 'v{u00ee}mes' 'v{u00ee}tes' 'wailers' 'want'
                'wards' 'wars' 'wiles' 'wise' 'wls' 'woodes'
                'workers' 'ws' 'xante' 'xas' 'xelles' 'xixe'
                'xonne' 'xtra' 'yahv{u00e9}' 'yale' 'yalta' 'yclades'
                'yc{u00e9}e' 'yerres' 'yes' 'yonez' 'yonne' 'ys'
                'yss{u00e9}e' 'ytals' 'yupiks' 'yvains' 'yves' 'yvonne'
                'zar{u00e9}' 'zins' 'z{u00e9}' 'z{u00e9}lote' '{u00e2}chet{u00e9}' '{u00e2}g{u00e9}'
                '{u00e2}ques' '{u00e7}oise' '{u00e8}bes' '{u00e8}s' '{u00e9}andres' '{u00e9}ant'
                '{u00e9}aux' '{u00e9}b{u00e9}' '{u00e9}cepte' '{u00e9}cuelle' '{u00e9}dienne' '{u00e9}gent'
                '{u00e9}g{u00e9}e' '{u00e9}hont{u00e9}' '{u00e9}lis{u00e9}e' '{u00e9}lys{u00e9}e' '{u00e9}lys{u00e9}es' '{u00e9}l{u00e9}e'
                '{u00e9}mesur{u00e9}' '{u00e9}minent' '{u00e9}m{u00e9}e' '{u00e9}nient' '{u00e9}n{u00e9}e' '{u00e9}n{u00e9}es'
                '{u00e9}pais' '{u00e9}pars' '{u00e9}phale' '{u00e9}p{u00e9}e' '{u00e9}quent' '{u00e9}rend'
                '{u00e9}rent' '{u00e9}s{u00e9}e' '{u00e9}ta' '{u00e9}tent' '{u00e9}tienne' '{u00e9}toile'
                '{u00e9}toil{u00e9}' '{u00e9}t{u00e9}' '{u00e9}viens' '{u00e9}volues' '{u00e9}ziers' '{u00ef}as'
                '{u00ef}bes' '{u00ef}s' '{u00ef}t{u00e9}' '{u00f4}s' '{u00f4}t{u00e9}' '{u00fb}ches'
                '{u00fb}lant' '{u00fc}es' '{u00fc}s' '{u0153}uds' '{u0153}urs'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
