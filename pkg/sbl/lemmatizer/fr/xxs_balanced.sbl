                'gr{u00e9}' 'hang{u00e9}' 'hias' 'homme' 'hra' 'htra'
                'hua' 'huit' 'iche' 'idu' 'ierra' 'ife'
                'if{u00e8}re' 'inn{u00e9}' 'inuit' 'ioche' 'ippe' 'islas'
                'java' 'jest{u00e9}' 'judas' 'kai' 'krit' 'kura'
                'k{u00e9}' 'large' 'lart{u00e9}' 'ldra' 'lerg{u00e9}' 'lit{u00e9}'
                'lmas' 'lont{u00e9}' 'ltime' 'luide' 'mit{u00e9}' 'morte'
                'mt{u00e9}' 'nass{u00e9}' 'nches' 'ndais' 'nfant' 'nias'
                'nissa' 'nit{u00e9}' 'nouit' 'ntaxe' 'n{u00e8}ve' 'ofit'
                'oit' 'olas' 'omas' 'om{u00e9}' 'onais' 'ora'
                'orse' 'oxe' 'o{u00e9}' 'papa' 'pas' 'pient'
                'pit' 'poule' 'proie' 'puche' 'qant' 'rgure'
                'rit{u00e9}' 'rras' 'rrons' 'rr{u00ea}ta' 'rr{u00ea}t{u00e9}' 'ruche'
                'sant{u00e9}' 'sche' 'sens{u00e9}' 'sias' 'sit{u00e9}' 'sprit'
                'su{u00e9}' 'tcha' 'tempe' 'tend' 'tends' 'terme'
                'texas' 'thas' 'th{u00e9}' 'tina' 'tions' 'tit{u00e9}'
                'ti{u00e9}' 'tuit' 't{u00e9}l{u00e9}' 'udit' 'uisse' 'uit{u00e9}'
                'umble' 'urde' 'urrez' 'vit{u00e9}' 'vroiz' 'v{u00ea}ch{u00e9}'
                'xit' 'xit{u00e9}' 'yota' 'ypte' 'zias' 'z{u00e9}'
                '{u00e2}g{u00e9}' '{u00e9}ant' '{u00e9}as' '{u00e9}b{u00e9}' '{u00e9}dent' '{u00e9}dera'
                '{u00e9}dit' '{u00e9}gera' '{u00e9}it{u00e9}' '{u00e9}mas' '{u00e9}rend' '{u00e9}rent'
                '{u00e9}rera' '{u00e9}tent' '{u00e9}t{u00e9}' '{u00e9}{u00e9}' '{u00ef}as' '{u00f4}t{u00e9}'
                '{u00fb}lera'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
