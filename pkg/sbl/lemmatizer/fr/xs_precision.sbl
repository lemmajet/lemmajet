                'aite' op_0_2 'a{u00ee}t' op_0_0 'crit' op_0_1 'dirent' op_0_5 'disent' op_0_4 'du' op_0_1
                'due' op_0_2 'dues' op_0_3 'duit' op_0_1 'duite' op_0_2 'duites' op_0_3 'dus' op_0_2
                'end' op_0_0 'endez' op_0_2 'ends' op_0_1 'ettant' op_0_3 'fait' op_0_1 'mettez' op_0_2
                'ndait' op_0_3 'ndant' op_0_3 'ndent' op_0_3 'ndit' op_0_2 'ndons' op_0_3 'ttent' op_0_3
                'uisant' op_0_4 'uisent' op_0_4 'uisit' op_0_3 'uits' op_0_2 'vivant' op_0_3 'vivent' op_0_3
                    (<- 're')
                'euse' op_0_2 'uses' op_0_3
                    (<- 'x')
                'oient' op_0_4
                    (<- 'yer')
                'af{u00e9}' 'alai' 'alais' 'als' 'amais' 'amine'
                'anais' 'anna' 'anne' 'ann{u00e9}e' 'ara' 'arais'
                'arce' 'argent' 'assez' 'autant' 'aut{u00e9}' 'avant'
                'bl{u00e9}' 'bras' 'b{u00e9}' 'b{u00e9}e' 'caisse' 'cant'
                'cens' 'cens{u00e9}' 'cent' 'comt{u00e9}' 'cor{u00e9}e' 'cques'
                'crime' 'dans' 'dise' 'embl{u00e9}e' 'enes' 'eresse'
                'et{u00e9}' 'eunes' 'fils' 'frais' 'front' 'galant'
                'gant' 'gens' 'ghts' 'grant' 'gr{u00e9}' 'guise'
                'honte' 'hua' 'h{u00e9}ra' 'id{u00e9}e' 'inte' 'it{u00e9}'
                'james' 'josu{u00e9}' 'kant' 'k{u00e9}' 'lanche' 'lues'
                'lyc{u00e9}e' 'manche' 'moins' 'ndais' 'ndale' 'nstant'
                'oids' 'omant' 'onais' 'onques' 'oots' 'ora'
                'orges' 'orient' 'o{u00e9}' 'pens' 'perse' 'perses'
                'petit' 'prins' 'proche' 'pr{u00e9}' 'riche' 'rles'
                'rose' 'rras' 'santa' 'sant{u00e9}' 'scient' 'sdits'
                'sieurs' 'terme' 'th{u00e9}e' 'tinent' 'ti{u00e9}' 'trans'
                'trente' 'ud{u00e9}e' 'urde' 'vall{u00e9}e' 'vante' 'vers'
                'vrai' '{u00e8}che' '{u00e9}ant' '{u00e9}dent' '{u00e9}glise' '{u00e9}lai'
                '{u00e9}lis{u00e9}e' '{u00e9}l{u00e9}' '{u00e9}norme' '{u00e9}p{u00e9}e' '{u00e9}quent' '{u00e9}rent'
                '{u00e9}t{u00e9}' '{u00f4}t{u00e9}' '{u0153}ufs'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
