                'leki' 'liam' 'licza' 'lie' 'lim' 'lm'
                'lnie' 'lo' 'lski' 'lty' 'ly' 'maga'
                'mi{u0119}ta' 'mm' 'mmy' 'mnie' 'mniej' 'mo'
                'myka' 'n' 'nary' 'nc' 'nch' 'ncy'
                'nnie' 'nowo' 'ntary' 'ntry' 'oa' 'oach'
                'oc' 'och' 'odoba' 'ogo' 'ogram' 'oh'
                'oi' 'oj' 'oko' 'omi' 'omina' 'oni'
                'oo' 'oom' 'oraj' 'otyka' 'ou' 'ow'
                'owni' 'oy' 'o{u0107}' 'o{u0142}' 'o{u0142}a' 'o{u0142}o'
                'o{u015b}cie' 'p' 'pada' 'pc' 'ph' 'phy'
                'pi' 'piej' 'pko' 'pnie' 'po' 'powie'
                'poza' 'ppy' 'przy' 'pr{u00f3}{u017c}no' 'pyta' 'p{u00f3}{u0142}'
                'q' 'r' 'rary' 'rasta' 'rasza' 'rc'
                'rch' 'rgo' 'ri' 'riana' 'rich' 'rij'
                'rim' 'rina' 'rm' 'rnie' 'ro' 'roch{u0119}'
                'rowo' 'rry' 'rudnia' 'rusza' 'rw' 'rwej'
                'rzej' 'rzych' 'r{u0105}ca' 's' 'sam' 'sby'
                'sc' 'sch' 'sh' 'sha' 'siaj' 'sm'
                'so' 'sob{u0105}' 'sowo' 'ssi' 'strach' 'sy{u0142}a'
                'szenko' 'szuka' 't' 'tc' 'tch' 'th'
                'them' 'thy' 'ti' 'tim' 'tm' 'tni'
                'tnie' 'to' 'to{u015b}' 'trwa' 'tty' 'tu{u0142}'
                'tw' 'twi' 'uc' 'uca' 'uch' 'ucy'
                'ugo' 'ui' 'um' 'umi' 'uno' 'uo'
                'urne' 'usi' 'uw' 'uwa' 'uy' 'v'
                'very' 'vi' 'vie' 'vii' 'vo' 'vy'
                'warza' 'wia' 'wich' 'wierza' 'wi{u015b}cie' 'wnie'
                'wski' 'x' 'xi' 'yc' 'ycza' 'yczaj'
                'yla' 'ylko' 'yma' 'yni' 'yo' 'ysi'
                'ystem' 'ys{u0142}' 'yw' 'ywa' 'ywi' 'yy'
                'y{u015b}' 'z' 'zawsze' 'zcza' 'zeda' 'zerze'
                'ze{u015b}' 'zia{u0142}' 'ziela' 'ziem' 'zm' 'zmi'
                'znie' 'zn{u00f3}w' 'zo' 'zw' 'zywie' 'zy{u015b}cie'
                'z{u00f3}d' 'z{u0142}' '{u00f3}ki' '{u00f3}tce' '{u00f3}wi' '{u00f3}wno'
                '{u0105}cza' '{u0105}da' '{u0105}ga' '{u0105}sa' '{u0107}by' '{u0107}ko'
                '{u0119}ca' '{u0119}cej' '{u0119}cza' '{u0119}dy' '{u0119}dzy' '{u0142}ada'
                '{u0142}m' '{u0142}ni' '{u0142}nia' '{u0142}owo' '{u0142}ucha' '{u0144}ski'
                '{u015b}c' '{u015b}ko' '{u015b}la' '{u015b}li' '{u015b}ni' '{u015b}nie'
                '{u015b}r{u00f3}d' '{u017c}' '{u017c}by' '{u017c}ej' '{u017c}eli' '{u017c}e{u015b}'
                '{u017c}nia' '{u017c}nie' '{u017c}o'
                    ()
            )
        ) or (
            [ next ] has_2 (delete set pfx_changed)
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'naj{u015b}p' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebi' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'nieb{u0105}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}m' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
