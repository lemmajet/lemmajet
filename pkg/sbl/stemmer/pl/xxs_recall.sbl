                '{u00f3}wno' '{u00f3}{u0142}owo' '{u00f3}{u015b}' '{u00f3}{u017a}nia' '{u00f3}{u017c}ni' '{u00f3}{u017c}no'
                '{u00f3}{u017c}owo' '{u0105}cza' '{u0105}cze' '{u0105}da' '{u0105}drze' '{u0105}ga'
                '{u0105}ka' '{u0105}sa' '{u0105}trzu' '{u0105}{u017c}a' '{u0107}by' '{u0107}kie'
                '{u0107}kim' '{u0107}ma' '{u0107}pani' '{u0119}baku' '{u0119}bia' '{u0119}bi{u00f3}w'
                '{u0119}bski' '{u0119}ca' '{u0119}cej' '{u0119}cem' '{u0119}cim' '{u0119}cza'
                '{u0119}czek' '{u0119}dnia' '{u0119}pia' '{u0119}pnia' '{u0119}si' '{u0119}sko'
                '{u0119}s{u0142}o' '{u0119}tki' '{u0119}{u015b}cie' '{u0119}{u017c}ko' '{u0142}ada' '{u0142}aga'
                '{u0142}asko' '{u0142}asza' '{u0142}ca' '{u0142}cza{u0142}' '{u0142}eba' '{u0142}kole'
                '{u0142}maty' '{u0142}nia' '{u0142}nie' '{u0142}no' '{u0142}odno' '{u0142}omek'
                '{u0142}one' '{u0142}ono' '{u0142}osi' '{u0142}osku' '{u0142}otki' '{u0142}o{u015b}ne'
                '{u0142}szu' '{u0142}tek' '{u0142}ubek' '{u0142}ucha' '{u0142}usem' '{u0142}usza'
                '{u0142}u{u015b}ci' '{u0142}u{u017c}a' '{u0142}yka' '{u0142}ynek' '{u0142}yska' '{u0142}ywa'
                '{u0142}zy' '{u0142}{u0119}ba' '{u0142}{u0142}' '{u0142}{u0142}o' '{u0142}{u0142}y' '{u0144}ski'
                '{u015b}la' '{u015b}liby' '{u015b}nie' '{u015b}rod{u0119}' '{u015b}r{u00f3}d' '{u015b}ta'
                '{u015b}wa' '{u015b}win{u0105}' '{u015b}wit{u0105}' '{u017a}no' '{u017a}ta' '{u017a}wo'
                '{u017c}aby' '{u017c}ala' '{u017c}arty' '{u017c}ar{u0142}o' '{u017c}by' '{u017c}cami'
                '{u017c}ci' '{u017c}d{u017c}a' '{u017c}ebra' '{u017c}ebry' '{u017c}ej' '{u017c}ejki'
                '{u017c}eli' '{u017c}e{u015b}' '{u017c}liwi' '{u017c}nia' '{u017c}nie' '{u017c}usia'
                '{u017c}ywa' '{u017c}ywie' '{u017c}ywo' '{u017c}{u0105}{u0107}'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'naj{u015b}p' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebi' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'nieb{u0105}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}m' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
