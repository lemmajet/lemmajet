    define op_6_6 as (test hop 6 $cutv = 6 set pfx_changed)
    define op_6_7 as (test hop 6 $cutv = 7 set pfx_changed)
    define op_6_8 as (test hop 6 $cutv = 8 set pfx_changed)
    define op_6_9 as (test hop 6 $cutv = 9 set pfx_changed)
    define op_7_7 as (test hop 7 $cutv = 7 set pfx_changed)
    define op_7_8 as (test hop 7 $cutv = 8 set pfx_changed)

    /* Stage 3: Pruned Reversed Suffix-Trie CutAdd Transducer */
    define apply_suffix_trie as (
        $cutv = 0
        (
            [ test substring hop cutv ] among (
                'a' op_3_1 'abak{u0119}' op_0_1 'abamba' op_0_1 'abarze' op_0_1 'abbie' op_0_2 'abcie' op_0_1
                'abecie' op_0_3 'abelce' op_0_2 'abelki' op_0_2 'abelk{u0105}' op_0_2 'abelk{u0119}' op_0_2 'abelli' op_0_1
                'abelo' op_0_1 'abierz' op_1_4 'abier{u0105}' op_1_4 'abino' op_0_1 'abio' op_0_1 'abior{u0105}' op_1_4
