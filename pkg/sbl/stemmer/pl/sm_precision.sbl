    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'naj{u015b}p' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebi' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'nieb{u0105}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}m' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
