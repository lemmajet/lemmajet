    define op_7_8 as (test hop 7 $cutv = 8 set pfx_changed)

    /* Stage 3: Pruned Reversed Suffix-Trie CutAdd Transducer */
    define apply_suffix_trie as (
        $cutv = 0
        (
            [ test substring hop cutv ] among (
                'a' op_3_1 'abierz' op_1_4 'abio' op_0_1 'abior{u0105}' op_1_4 'abior{u0119}' op_1_4 'abla' op_0_1
                'ablach' op_0_3 'ablice' op_0_1 'abrali' op_1_4 'abrana' op_1_4 'abrane' op_1_4 'abrani' op_1_4
                'abrano' op_1_4 'abrany' op_1_4 'abran{u0105}' op_1_4 'abra{u0107}' op_1_3 'abra{u0142}' op_1_3 'abra{u0142}a' op_1_4
