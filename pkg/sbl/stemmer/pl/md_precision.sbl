                '{u015b}wit{u0105}' '{u015b}wi{u0105}ty' '{u017a}gn{u0119}{u0142}y' '{u017a}kami' '{u017a}la' '{u017a}liwie'
                '{u017a}lu' '{u017a}niaki' '{u017a}nickim' '{u017a}ni{u0105}t' '{u017a}ni{u0119}ta' '{u017a}no'
                '{u017a}no{u015b}{u0107}' '{u017a}ta' '{u017a}wa' '{u017a}wia' '{u017a}wienie' '{u017a}wiga'
                '{u017a}wiony' '{u017a}wo' '{u017a}wo{u015b}ci' '{u017c}aby' '{u017c}actwem' '{u017c}acze'
                '{u017c}ady' '{u017c}ala' '{u017c}alstwa' '{u017c}aluzji' '{u017c}anach' '{u017c}anami'
                '{u017c}aninie' '{u017c}ansach' '{u017c}aracie' '{u017c}arii' '{u017c}arki' '{u017c}arni'
                '{u017c}arnowa' '{u017c}arowo' '{u017c}arska' '{u017c}arty' '{u017c}awny' '{u017c}a{u0144}ski'
                '{u017c}biony' '{u017c}bi{u0105}c' '{u017c}bowali' '{u017c}by' '{u017c}cami' '{u017c}cem'
                '{u017c}ci' '{u017c}c{u0105}' '{u017c}dy' '{u017c}dzie' '{u017c}d{u017c}a' '{u017c}ebno{u015b}{u0107}'
                '{u017c}ebra' '{u017c}ebry' '{u017c}eby{u0107}' '{u017c}ega{u0142}a' '{u017c}ej' '{u017c}eje'
                '{u017c}ejki' '{u017c}ej{u0105}' '{u017c}elek' '{u017c}eli' '{u017c}eliby' '{u017c}elu'
                '{u017c}enady' '{u017c}eniej' '{u017c}enk{u0119}' '{u017c}enny' '{u017c}ercami' '{u017c}erc{u00f3}w'
                '{u017c}erc{u0119}' '{u017c}erdzi' '{u017c}erk{u0119}' '{u017c}ernych' '{u017c}erski' '{u017c}ewo'
                '{u017c}ewska' '{u017c}e{u0142}' '{u017c}e{u0144}szy' '{u017c}e{u015b}' '{u017c}ga' '{u017c}ga{u0142}'
                '{u017c}im' '{u017c}imowej' '{u017c}imowym' '{u017c}kowie' '{u017c}li' '{u017c}liwi'
                '{u017c}liwie' '{u017c}maki' '{u017c}mij' '{u017c}nia' '{u017c}nialne' '{u017c}niczy'
                '{u017c}nie' '{u017c}niow{u0105}' '{u017c}ocka' '{u017c}odzino' '{u017c}ogiem' '{u017c}oniska'
                '{u017c}owowi' '{u017c}owska' '{u017c}o{u0142}ki' '{u017c}rej' '{u017c}top{u00f3}r' '{u017c}uan{u00f3}w'
                '{u017c}uczki' '{u017c}ujkami' '{u017c}ule' '{u017c}ulka' '{u017c}upy' '{u017c}urka'
                '{u017c}usia' '{u017c}u{u0142}' '{u017c}wi{u0144}sk{u0105}' '{u017c}ychy' '{u017c}yki' '{u017c}ylecie'
                '{u017c}ymanie' '{u017c}yma{u0142}' '{u017c}ynki' '{u017c}ynk{u0119}' '{u017c}ystek' '{u017c}ystk{u0105}'
                '{u017c}ystom' '{u017c}yst{u0105}' '{u017c}ytuje' '{u017c}ywc{u00f3}w' '{u017c}ywie' '{u017c}ywn{u0105}'
                '{u017c}ywo' '{u017c}{u0105}dz' '{u017c}{u0105}{u0107}' '{u017c}{u0119}te'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'naj{u015b}p' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebi' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'nieb{u0105}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}m' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
