                'xa' 'xem' 'xu' 'ya' 'yby' 'ycha'
                'ych{u00f3}w' 'ycza' 'yczaj' 'yga' 'ygani' 'ygasa'
                'yhym' 'ykupu' 'yla' 'ylko' 'yma' 'yni'
                'ynika' 'yplom' 'ysi' 'yska' 'ystem' 'ysze'
                'ys{u0142}' 'ytona' 'ytrze' 'ytyk{u0119}' 'yy' 'y{u015b}'
                'zalni' 'zapa{u0142}' 'zap{u0119}' 'zarni' 'zasi{u0119}' 'zatem'
                'za{u0142}{u0105}' 'za{u015b}' 'zcza' 'zeci' 'zeda' 'zegom'
                'zelni' 'zerza' 'zerze' 'ze{u015b}' 'zhu' 'ziej'
                'ziela' 'ziem' 'ziera' 'zie{u015b}' 'zisa' 'zisie'
                'zmar{u0142}' 'znie' 'zniem' 'zn{u00f3}w' 'zrazu' 'zuka'
                'zyb{u00f3}r' 'zyci' 'zyta' 'zywa' 'zywie' 'zy{u015b}my'
                'zza' 'zzy' 'z{u00f3}d' 'z{u0142}' 'z{u0142}ek' 'z{u0142}o{u017c}a'
                '{u00f3}dy' '{u00f3}dzi' '{u00f3}dzki' '{u00f3}ki' '{u00f3}kim' '{u00f3}rni'
                '{u00f3}rski' '{u00f3}ty' '{u00f3}wna' '{u00f3}wn{u0119}' '{u00f3}{u017a}nia' '{u0105}cza'
                '{u0105}cze' '{u0105}da' '{u0105}drze' '{u0105}ga' '{u0105}sa' '{u0105}{u017c}a'
                '{u0107}by' '{u0107}ko' '{u0119}bia' '{u0119}bski' '{u0119}ca' '{u0119}cej'
                '{u0119}cza' '{u0119}dnia' '{u0119}dy' '{u0119}dzy' '{u0119}ka' '{u0119}pnia'
                '{u0119}si' '{u0119}{u015b}cie' '{u0142}ada' '{u0142}asza' '{u0142}by' '{u0142}ca'
                '{u0142}ni' '{u0142}nia' '{u0142}nie' '{u0142}oby' '{u0142}szu' '{u0142}ucha'
                '{u0142}u{u017c}a' '{u0142}ywa' '{u0142}{u0119}ba' '{u0142}{u0142}' '{u0142}{u0142}a' '{u0142}{u0142}o'
                '{u0142}{u0142}y' '{u0144}ski' '{u015b}la' '{u015b}ni' '{u015b}nie' '{u015b}r{u00f3}d'
                '{u015b}ta' '{u015b}wa' '{u015b}wit{u0105}' '{u017a}ni' '{u017a}ta' '{u017c}arty'
                '{u017c}by' '{u017c}ci' '{u017c}ej' '{u017c}eli' '{u017c}e{u015b}' '{u017c}kowa'
                '{u017c}nia' '{u017c}nie' '{u017c}wawo' '{u017c}ywa' '{u017c}ywie'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define rem_2 as test (hop 2)
define rem_4 as test (hop 4)

define strip_prefix as (
    $(len > 4)
    [substring] among (
        'naj' rem_4 (delete set pfx_changed)
        'najad' (false)
        'najar' (false)
        'najaz' (false)
        'najdw' (false)
        'najd{u0105}' (false)
        'najd{u0119}' (false)
        'najd{u017a}' (false)
        'naje' (false)
        'najef' rem_2 (<- 'ef' set pfx_changed)
        'najeg' rem_2 (<- 'eg' set pfx_changed)
        'najek' rem_2 (<- 'ek' set pfx_changed)
        'najel' rem_2 (<- 'el' set pfx_changed)
        'najen' rem_2 (<- 'en' set pfx_changed)
        'najes' rem_2 (<- 'es' set pfx_changed)
        'najif' (false)
        'najki' (false)
        'najkw' (false)
        'najme' (false)
        'najmu' (false)
        'najmy' (false)
        'najm{u00f3}' (false)
        'najtc' (false)
        'najtk' (false)
        'najtu' (false)
        'najuk' (false)
        'najul' (false)
        'najw{u017c}' (false)
        'naj{u0105}' (false)
        'naj{u0119}' (false)
        'nie' rem_4 (delete set pfx_changed)
        'nieag' (false)
        'nieau' (false)
        'niebe' (false)
        'niebo' (false)
        'nieby' (false)
        'nieb{u00f3}' (false)
        'niecc' (false)
        'nieck' (false)
        'niecn' (false)
        'niecu' (false)
        'niec{u0105}' (false)
        'niedb' (false)
        'niedi' (false)
        'niedw' (false)
        'nied{u0142}' (false)
        'nied{u017a}' (false)
        'nied{u017c}' (false)
        'nieee' (false)
        'nieef' (false)
        'nieen' (false)
        'nieet' (false)
        'nieeu' (false)
        'niegd' (false)
        'niehi' (false)
        'nieke' (false)
        'niekt' (false)
        'nielb' (false)
        'niels' (false)
        'nielz' (false)
        'niemc' (false)
        'niemk' (false)
        'niem{u0142}' (false)
        'nienc' (false)
        'niens' (false)
        'niepe' (false)
        'niepp' (false)
        'niept' (false)
        'niepw' (false)
        'nierd' (false)
        'nier{u00f3}' (false)
        'niese' (false)
        'nieso' (false)
        'nietz' (false)
        'niewo' (false)
        'niew{u00f3}' (false)
        'niew{u0105}' (false)
        'nie{u0107}k' (false)
        'nie{u015b}m' (false)
        'nie{u015b}t' (false)
        'nie{u015b}{u0107}' (false)
        'nie{u017a}' (false)
        'nie{u017c}o' (false)
    )
)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
