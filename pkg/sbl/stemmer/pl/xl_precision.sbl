    define op_3_9 as (test hop 3 $cutv = 9 set pfx_changed)
    define op_4_5 as (test hop 4 $cutv = 5 set pfx_changed)
    define op_4_6 as (test hop 4 $cutv = 6 set pfx_changed)
    define op_4_7 as (test hop 4 $cutv = 7 set pfx_changed)
