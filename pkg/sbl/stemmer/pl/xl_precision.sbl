    /* Stage 2b: Movable Enclitic Stripping */
    define strip_enclitics as (false)

    define op_0_0 as ($cutv = 0 set pfx_changed)
    define op_0_1 as ($cutv = 1 set pfx_changed)
    define op_0_2 as ($cutv = 2 set pfx_changed)
    define op_0_3 as ($cutv = 3 set pfx_changed)
    define op_0_4 as ($cutv = 4 set pfx_changed)
    define op_0_5 as ($cutv = 5 set pfx_changed)
    define op_0_6 as ($cutv = 6 set pfx_changed)
    define op_0_7 as ($cutv = 7 set pfx_changed)
    define op_0_8 as ($cutv = 8 set pfx_changed)
    define op_0_9 as ($cutv = 9 set pfx_changed)
    define op_1_1 as (test next $cutv = 1 set pfx_changed)
    define op_1_10 as (test next $cutv = 10 set pfx_changed)
    define op_1_2 as (test next $cutv = 2 set pfx_changed)
    define op_1_3 as (test next $cutv = 3 set pfx_changed)
    define op_1_4 as (test next $cutv = 4 set pfx_changed)
    define op_1_5 as (test next $cutv = 5 set pfx_changed)
    define op_1_6 as (test next $cutv = 6 set pfx_changed)
    define op_1_7 as (test next $cutv = 7 set pfx_changed)
    define op_1_8 as (test next $cutv = 8 set pfx_changed)
    define op_1_9 as (test next $cutv = 9 set pfx_changed)
    define op_2_1 as (test hop 2 $cutv = 1 set pfx_changed)
    define op_2_10 as (test hop 2 $cutv = 10 set pfx_changed)
    define op_2_11 as (test hop 2 $cutv = 11 set pfx_changed)
    define op_2_2 as (test hop 2 $cutv = 2 set pfx_changed)
    define op_2_3 as (test hop 2 $cutv = 3 set pfx_changed)
    define op_2_4 as (test hop 2 $cutv = 4 set pfx_changed)
    define op_2_5 as (test hop 2 $cutv = 5 set pfx_changed)
    define op_2_6 as (test hop 2 $cutv = 6 set pfx_changed)
    define op_2_7 as (test hop 2 $cutv = 7 set pfx_changed)
    define op_2_8 as (test hop 2 $cutv = 8 set pfx_changed)
    define op_2_9 as (test hop 2 $cutv = 9 set pfx_changed)
    define op_3_10 as (test hop 3 $cutv = 10 set pfx_changed)
    define op_3_11 as (test hop 3 $cutv = 11 set pfx_changed)
    define op_3_3 as (test hop 3 $cutv = 3 set pfx_changed)
    define op_3_4 as (test hop 3 $cutv = 4 set pfx_changed)
