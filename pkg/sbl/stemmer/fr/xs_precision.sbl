                'ueva' 'ufis' 'uh{u00e9}' 'uier' 'umba' 'umi{u00e9}'
                'ung{u00e9}' 'unn{u00e9}' 'unut' 'uota' 'upp{u00e9}' 'upt{u00e9}'
                'urle' 'url{u00e9}' 'vel{u00e9}' 'vier' 'vou{u00e9}' 'wai'
                'was' 'wer' 'xcez' 'xit' 'yas' 'yber'
                'ych{u00e9}' 'yer' 'yler' 'ylla' 'yota' 'yper'
                'ytas' 'yver' 'zai' 'zar{u00e9}' 'zer' 'zias'
                'zier' 'z{u00e9}' '{u00e2}g{u00e9}' '{u00e2}ndu' '{u00e9}ais' '{u00e9}ait'
                '{u00e9}as' '{u00e9}ber' '{u00e9}b{u00e9}' '{u00e9}cr{u00e9}' '{u00e9}cu{u00e9}' '{u00e9}ez'
                '{u00e9}gl{u00e9}' '{u00e9}ier' '{u00e9}lai' '{u00e9}lit' '{u00e9}l{u00e9}' '{u00e9}mas'
                '{u00e9}nez' '{u00e9}nn{u00e9}' '{u00e9}pas' '{u00e9}pri' '{u00e9}ser' '{u00e9}tit'
                '{u00e9}vas' '{u00e9}{u00e9}' '{u00ea}l{u00e9}' '{u00ea}ta' '{u00ef}as' '{u00f6}der'
                '{u00fb}ler' '{u00fb}l{u00e9}' '{u00fc}ber'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
