  '{u00e9}cri{u00e9}' (false)
  '{u00e9}dera' (false)
  '{u00e9}er' (false)
  '{u00e9}gler' (false)
  '{u00e9}gl{u00e9}' (false)
  '{u00e9}grer' (false)
  '{u00e9}lai' (false)
  '{u00e9}lais' (false)
  '{u00e9}lit' (false)
  '{u00e9}l{u00e9}' (false)
  '{u00e9}mas' (false)
  '{u00e9}mons' (false)
  '{u00e9}rend' (false)
  '{u00e9}rent' (false)
  '{u00e9}rera' (false)
  '{u00e9}ser' (false)
  '{u00e9}tent' (false)
  '{u00e9}toit' (false)
  '{u00e9}t{u00e9}' (false)
  '{u00e9}{u00e9}' (false)
  '{u00ef}as' (false)
  '{u00f4}t{u00e9}' (false)
  '{u00fb}ler' (false)
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
