                '{u00ef}s' '{u00ef}ssoiz' '{u00ef}stes' '{u00ef}t{u00e9}' '{u00ef}{u00e9}tiques' '{u00f4}s'
                '{u00f4}ties' '{u00f4}t{u00e9}' '{u00f6}der' '{u00f6}ller' '{u00fb}cher' '{u00fb}ches'
