                '{u00e9}mand{u00e9}' '{u00e9}marche' '{u00e9}mas' '{u00e9}menter' '{u00e9}mentes' '{u00e9}minent'
                '{u00e9}min{u00e9}' '{u00e9}mons' '{u00e9}m{u00e9}dit{u00e9}' '{u00e9}m{u00e9}rite' '{u00e9}nez' '{u00e9}nient'
                '{u00e9}nn{u00e9}' '{u00e9}nou{u00e9}' '{u00e9}od{u00e9}' '{u00e9}opage' '{u00e9}outes' '{u00e9}ouvert'
                '{u00e9}pais' '{u00e9}parti' '{u00e9}pas' '{u00e9}pel{u00e9}' '{u00e9}perdu' '{u00e9}pidant'
                '{u00e9}plait' '{u00e9}plient' '{u00e9}pri' '{u00e9}publi{u00e9}' '{u00e9}quant' '{u00e9}quent'
                '{u00e9}querre' '{u00e9}rache' '{u00e9}rend' '{u00e9}rends' '{u00e9}rent' '{u00e9}requis'
                '{u00e9}rera' '{u00e9}rerai' '{u00e9}rerait' '{u00e9}reront' '{u00e9}rilla' '{u00e9}rillas'
                '{u00e9}rim{u00e9}' '{u00e9}riple' '{u00e9}risons' '{u00e9}ri{u00e9}' '{u00e9}r{u00e9}gul{u00e9}' '{u00e9}saigne'
                '{u00e9}ser' '{u00e9}silas' '{u00e9}talis{u00e9}' '{u00e9}tampes' '{u00e9}tam{u00e9}' '{u00e9}tendre'
                '{u00e9}tent' '{u00e9}tera' '{u00e9}tis' '{u00e9}tit' '{u00e9}toient' '{u00e9}tribue'
                '{u00e9}trit' '{u00e9}t{u00e9}r{u00e9}' '{u00e9}va' '{u00e9}vas' '{u00e9}veine' '{u00e9}voy{u00e9}'
                '{u00e9}{u00e8}rent' '{u00e9}{u00e9}' '{u00ea}lant' '{u00ea}l{u00e9}' '{u00eb}ez' '{u00eb}vrons'
                '{u00ef}adas' '{u00ef}as' '{u00ef}sant' '{u00f4}tel{u00e9}' '{u00f6}der' '{u00f6}ller'
                '{u00fb}cher' '{u00fb}laient' '{u00fb}lait' '{u00fb}lant' '{u00fb}lent' '{u00fb}ler'
                '{u00fb}lera' '{u00fb}lerai' '{u00fb}leras' '{u00fb}lerez' '{u00fb}leront' '{u00fb}lons'
                '{u00fb}l{u00e8}rent' '{u00fb}l{u00e9}' '{u00fc}ber' '{u00fc}ller' '{u00fc}nter' '{u00fc}ssez'
                '{u0153}ur{u00e9}'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
