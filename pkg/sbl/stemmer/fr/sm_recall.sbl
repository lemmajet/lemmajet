                '{u00e9}cepte' '{u00e9}chant' '{u00e9}chera' '{u00e9}chis{u00e9}' '{u00e9}cites' '{u00e9}con{u00e7}u'
                '{u00e9}cote' '{u00e9}cours' '{u00e9}court' '{u00e9}crie' '{u00e9}cr{u00e9}' '{u00e9}dent'
                '{u00e9}dera' '{u00e9}deras' '{u00e9}derez' '{u00e9}diqu{u00e9}' '{u00e9}dules' '{u00e9}d{u00e9}ra'
                '{u00e9}erait' '{u00e9}eront' '{u00e9}ez' '{u00e9}gera' '{u00e9}glant' '{u00e9}gler'
                '{u00e9}glera' '{u00e9}glez' '{u00e9}gl{u00e9}' '{u00e9}gnera' '{u00e9}grait' '{u00e9}grer'
                '{u00e9}grons' '{u00e9}ifi{u00e9}' '{u00e9}lai' '{u00e9}lais' '{u00e9}laite' '{u00e9}lasse'
                '{u00e9}lay{u00e9}' '{u00e9}lera' '{u00e9}lisse' '{u00e9}lit' '{u00e9}lita' '{u00e9}l{u00e9}'
                '{u00e9}l{u00e9}gie' '{u00e9}mand{u00e9}' '{u00e9}mas' '{u00e9}min{u00e9}' '{u00e9}mons' '{u00e9}nez'
                '{u00e9}nn{u00e9}' '{u00e9}nou{u00e9}' '{u00e9}od{u00e9}' '{u00e9}opage' '{u00e9}pais' '{u00e9}parti'
                '{u00e9}pas' '{u00e9}pel{u00e9}' '{u00e9}perdu' '{u00e9}plait' '{u00e9}pri' '{u00e9}quant'
                '{u00e9}quent' '{u00e9}rache' '{u00e9}rend' '{u00e9}rends' '{u00e9}rent' '{u00e9}rera'
                '{u00e9}rerai' '{u00e9}rilla' '{u00e9}rim{u00e9}' '{u00e9}riple' '{u00e9}ri{u00e9}' '{u00e9}ser'
                '{u00e9}silas' '{u00e9}tam{u00e9}' '{u00e9}tent' '{u00e9}tera' '{u00e9}tis' '{u00e9}tit'
                '{u00e9}trit' '{u00e9}t{u00e9}r{u00e9}' '{u00e9}vas' '{u00e9}veine' '{u00e9}voy{u00e9}' '{u00e9}v{u00e8}re'
                '{u00e9}{u00e8}rent' '{u00e9}{u00e9}' '{u00ea}lant' '{u00ea}l{u00e9}' '{u00eb}ez' '{u00eb}vrons'
                '{u00ef}adas' '{u00ef}as' '{u00ef}rent' '{u00ef}sant' '{u00f4}tel{u00e9}' '{u00f6}der'
                '{u00f6}ller' '{u00fb}cher' '{u00fb}lait' '{u00fb}lant' '{u00fb}lent' '{u00fb}ler'
                '{u00fb}lera' '{u00fb}lerai' '{u00fb}leras' '{u00fb}lerez' '{u00fb}lons' '{u00fb}l{u00e9}'
                '{u00fc}ber' '{u00fc}ller' '{u00fc}nter' '{u00fc}ssez' '{u0153}ur{u00e9}'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
