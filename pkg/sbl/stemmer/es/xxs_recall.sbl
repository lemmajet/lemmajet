                '{u00e1}mbar' '{u00e1}mica' '{u00e1}ndar' '{u00e1}ndo' '{u00e1}nos' '{u00e1}riz'
                '{u00e1}rtir' '{u00e1}zar' '{u00e9}cada' '{u00e9}ctar' '{u00e9}pido' '{u00e9}rica'
                '{u00e9}rida' '{u00e9}sar' '{u00ed}ada' '{u00ed}ades' '{u00ed}bar' '{u00ed}dolo'
                '{u00ed}gado' '{u00ed}jele' '{u00ed}laba' '{u00ed}mar' '{u00ed}mica' '{u00ed}mite'
                '{u00ed}var' '{u00f1}uelo' '{u00f3}lar' '{u00f3}les' '{u00f3}lver' '{u00f3}scar'
                '{u00fa}car' '{u00fa}sico' '{u00fc}ense'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
