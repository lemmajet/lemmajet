                '{u00ed}alos' op_2_5 '{u00ed}ame' op_2_4 '{u00ed}an' op_4_5 '{u00ed}anos' op_2_5 '{u00ed}ate' op_2_4 '{u00ed}calas' op_2_6
                '{u00ed}cales' op_2_6 '{u00ed}calos' op_2_6 '{u00ed}canos' op_2_6 '{u00ed}cita' op_0_1 '{u00ed}cito' op_0_1 '{u00ed}do' op_2_3
                '{u00ed}e' op_2_2 '{u00ed}ela' op_2_4 '{u00ed}elas' op_2_5 '{u00ed}ele' op_2_4 '{u00ed}eles' op_2_5 '{u00ed}elo' op_2_4
                '{u00ed}elos' op_2_5 '{u00ed}eme' op_2_4 '{u00ed}en' op_2_3 '{u00ed}enla' op_2_5 '{u00ed}enlas' op_2_6 '{u00ed}enle' op_2_5
                '{u00ed}enles' op_2_6 '{u00ed}enlo' op_2_5 '{u00ed}enlos' op_2_6 '{u00ed}enme' op_2_5 '{u00ed}ennos' op_2_6 '{u00ed}enos' op_2_5
                '{u00ed}ense' op_2_5 '{u00ed}os' op_2_3 '{u00ed}s' op_2_2 '{u00ed}z' op_1_1 '{u00f1}ad' op_1_2 '{u00f1}amos' op_1_4
                '{u00f1}e' op_1_1 '{u00f1}emos' op_1_4 '{u00f1}en' op_1_2 '{u00f1}os' op_0_1 '{u00f1}{u00e1}' op_1_1 '{u00f1}{u00e1}s' op_1_2
                '{u00f1}{u00e9}is' op_1_3 '{u00f3}' op_2_1 '{u00f3}nimos' op_0_1 '{u00f3}se' op_2_3 '{u00fa}a' op_2_2 '{u00fa}an' op_2_3
                '{u00fa}e' op_2_2 '{u00fa}en' op_2_3 '{u00fa}rales' op_2_6
                    (delete)
                'quen' op_1_4 'qu{u00e9}' op_1_3 'zca' op_1_3 'zcan' op_1_4
                    (<- 'c')
                'nelas' op_2_6 'nese' op_2_5 '{u00f3}nales' op_1_6 '{u00f3}nela' op_1_5
                    (<- 'on')
                'ac{u00e1}' 'ader{u00ed}a' 'aida' 'air' 'alones' 'ander'
                'andos' 'arate' 'ard{u00ed}a' 'a{u00ed}s' 'bate' 'ceas'
                'clase' 'dados' 'dones' 'eban' 'eladas' 'enes'
                'er{u00f3}n' 'esse' 'estad' 'etivo' 'falo' 'fase'
                'fitas' 'gen' 'ges' 'gr{u00ed}a' 'iadora' 'icida'
                'idense' 'ides' 'ien' 'ime' 'ines' 'ise'
                'izales' 'jer{u00ed}a' 'ken' 'ler{u00ed}a' 'mala' 'mate'
                'medida' 'men' 'mer{u00ed}a' 'mistad' 'mundo' 'm{u00e9}rica'
                'ner{u00ed}a' 'nnan' 'nnes' 'nsen' 'nt{u00ed}a' 'od{u00ed}a'
                'oir' 'ondo' 'onido' 'onle' 'onme' 'orme'
