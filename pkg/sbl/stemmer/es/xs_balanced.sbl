                    (<- 'o')
                'elto' op_2_5
                    (<- 'olv')
                'nela' op_2_5 'nelas' op_2_6 'nese' op_2_5 '{u00f3}nala' op_1_5 '{u00f3}nalas' op_1_6 '{u00f3}nale' op_1_5
                '{u00f3}nales' op_1_6 '{u00f3}nalo' op_1_5 '{u00f3}nalos' op_1_6 '{u00f3}name' op_1_5 '{u00f3}nanos' op_1_6 '{u00f3}nate' op_1_5
                '{u00f3}nele' op_1_5 '{u00f3}neles' op_1_6 '{u00f3}nelo' op_1_5 '{u00f3}nelos' op_1_6 '{u00f3}neme' op_1_5 '{u00f3}nenla' op_1_6
                '{u00f3}nenle' op_1_6 '{u00f3}nenlo' op_1_6 '{u00f3}nenme' op_1_6 '{u00f3}nenos' op_1_6 '{u00f3}nense' op_1_6
                    (<- 'on')
                'yanla' op_2_6 'yanle' op_2_6 'yanlo' op_2_6 'yanme' op_2_6 'yanse' op_2_6 'yete' op_2_5
                '{u00fa}yanos' op_1_6 '{u00fa}yase' op_1_5
                    (<- 'u')
                'ncen' op_0_3 'veces' op_0_3
                    (<- 'z')
                'abad' 'acana' 'acoso' 'ac{u00e1}' 'adar' 'ader{u00ed}a'
                'aguna' 'aici{u00f3}n' 'aid' 'aida' 'air' 'alada'
