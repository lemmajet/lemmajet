                '{u00ed}telas' op_1_6 '{u00ed}teles' op_1_6 '{u00ed}telo' op_1_5 '{u00ed}telos' op_1_6 '{u00ed}tenla' op_1_6 '{u00ed}tenle' op_1_6
                '{u00ed}tenlo' op_1_6 '{u00ed}tenme' op_1_6 '{u00ed}tenos' op_1_6 '{u00ed}tense' op_1_6
                    (<- 'it')
                'unido' op_0_3 '{u00f3}cala' op_1_5 '{u00f3}calas' op_1_6 '{u00f3}cale' op_1_5 '{u00f3}cales' op_1_6 '{u00f3}calo' op_1_5
