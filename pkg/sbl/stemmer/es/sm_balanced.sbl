                '{u00f3}nces' '{u00f3}nidas' '{u00f3}nimo' '{u00f3}rden' '{u00f3}rfido' '{u00f3}rtica'
                '{u00f3}rtico' '{u00f3}sigo' '{u00f3}stico' '{u00f3}tida' '{u00f3}tido' '{u00fa}car'
                '{u00fa}cico' '{u00fa}cidos' '{u00fa}far' '{u00fa}mido' '{u00fa}ncula' '{u00fa}ngara'
                '{u00fa}plica' '{u00fa}pose' '{u00fa}ridos' '{u00fa}sares' '{u00fa}sica' '{u00fa}sico'
                '{u00fc}elles' '{u00fc}elven' '{u00fc}ense' '{u00fc}escos' '{u00fc}esos'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
