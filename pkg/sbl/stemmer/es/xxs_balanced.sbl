                'tacar' 'tamen' 'tasa' 'tcha' 'tedes' 'tenar'
                'ter{u00ed}a' 'teses' 'texas' 'than' 'tian' 'tijo'
                'times' 'tman' 'tras' 'trece' 'trino' 'tr{u00e1}n'
                'tr{u00ed}a' 'uadir' 'uan' 'ucta' 'uendo' 'uerdo'
                'uerte' 'uesca' 'ugar' 'uiera' 'uiles' 'uiz{u00e1}'
                'uiz{u00e1}s' 'umos' 'unes' 'ur{u00ed}a' 'utica' 'uyas'
                'veen' 'vegar' 'venta' 'veses' 'vino' 'vinos'
                'vivos' 'volta' 'votos' 'v{u00ed}os' 'wan' 'war'
                'ware' 'wen' 'women' 'xamen' 'xido' 'xilar'
                'xos' 'yemen' 'ynes' 'yos' 'ysa' 'ytes'
                'zen' 'zoos' 'zuela' 'zuelo' '{u00e1}base' '{u00e1}cido'
                '{u00e1}les' '{u00e1}mara' '{u00e1}mica' '{u00e1}ndar' '{u00e1}ndo' '{u00e1}zar'
                '{u00e9}cada' '{u00e9}llas' '{u00e9}llos' '{u00e9}me' '{u00e9}nes' '{u00e9}pido'
