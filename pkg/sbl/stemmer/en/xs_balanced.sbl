                'khs' 'kies' 'kins' 'kkes' 'kons' 'kses'
                'kts' 'kvs' 'kwon' 'lacs' 'lahs' 'lans'
                'lbs' 'lcs' 'ldes' 'lecs' 'leds' 'lens'
                'lfry' 'lims' 'lins' 'lips' 'lkes' 'lks'
                'lles' 'lmed' 'lmes' 'lons' 'macs' 'mads'
                'mens' 'mics' 'mids' 'mips' 'mls' 'mms'
                'mned' 'mohs' 'mors' 'mphs' 'mrs' 'mts'
                'murs' 'mzes' 'naed' 'nans' 'nded' 'ndes'
                'nems' 'news' 'nfs' 'nhs' 'nics' 'nids'
                'nkle' 'nnes' 'noes' 'nons' 'nors' 'nps'
                'ntes' 'nths' 'nuts' 'oaks' 'oaps' 'oers'
                'ofs' 'ofts' 'onds' 'oned' 'oods' 'opts'
