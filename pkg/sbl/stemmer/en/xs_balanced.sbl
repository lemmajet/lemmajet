                'peds' 'pees' 'pens' 'pets' 'pics' 'pirs'
                'pls' 'pns' 'pods' 'pors' 'ppes' 'prs'
                'pted' 'pths' 'qbs' 'qrs' 'qs' 'rabs'
                'rans' 'rbed' 'rbes' 'rcs' 'rdes' 'red'
                'rens' 'rfs' 'risy' 'rits' 'rkes' 'rlds'
                'rles' 'rmed' 'rmes' 'rnes' 'rons' 'rors'
                'rots' 'rped' 'rphs' 'rres' 'rtes' 'rths'
                'rums' 'rups' 'rzed' 'saks' 'sbs' 'sced'
                'sces' 'secs' 'sens' 'shs' 'sics' 'sids'
                'sigs' 'smbs' 'smes' 'soms' 'sons' 'srs'
                'ss' 'sted' 'svs' 'syed' 'tats' 'tbed'
                'tbs' 'tcs' 'tds' 'tecs' 'tens' 'thom'
                'tics' 'tids' 'ties' 'tkes' 'tms' 'tons'
                'tows' 'tues' 'tups' 'tvs' 'ucs' 'uids'
                'uies' 'uils' 'uks' 'ules' 'uons' 'uors'
                'upts' 'urds' 'urks' 'us' 'uths' 'uums'
                'uzed' 'uzis' 'vacs' 'vaks' 'vals' 'vans'
                'vds' 'vens' 'vets' 'vhs' 'vics' 'vids'
                'vify' 'vms' 'vors' 'vrts' 'wals' 'wens'
                'wes' 'wits' 'wles' 'wned' 'wnes' 'wns'
                'woes' 'wps' 'wups' 'xans' 'xons' 'yads'
                'yans' 'yars' 'yces' 'yds' 'yees' 'yers'
                'yls' 'ymes' 'ynds' 'ynes' 'yphs' 'yrds'
                'ys' 'ytes' 'yves' 'ywed' 'zals' 'zens'
                'zies' 'zins' 'zits'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
