                'lours' 'lsing' 'ltry' 'lways' 'mas' 'matics'
                'monds' 'mons' 'mored' 'mrs' 'nabled' 'ndres'
                'nduce' 'needed' 'news' 'ngoing' 'nics' 'nings'
                'nised' 'nnes' 'nowned' 'nsas' 'ntents' 'ntrary'
                'oaming' 'ocles' 'odest' 'ogers' 'oings' 'olored'
                'omics' 'onas' 'onored' 'ontest' 'onting' 'orised'
                'orming' 'orned' 'orning' 'oros' 'ostas' 'otest'
                'oured' 'ouring' 'oveted' 'owards' 'owered' 'pas'
                'pected' 'pening' 'phelps' 'pics' 'pings' 'ppines'
                'priest' 'pulled' 'pwards' 'rbed' 'rbucks' 'rdered'
                'remy' 'rested' 'rhaps' 'ricted' 'riefly' 'rited'
                'rkings' 'rles' 'rply' 'rps' 'rseas' 'rsity'
                'rtes' 'seeded' 'sening' 'series' 'simply' 'sings'
                'soning' 'ss' 'stics' 'stoms' 'stos' 'swing'
                'sys' 'tairs' 'tected' 'tended' 'tening' 'tented'
                'thens' 'thews' 'thics' 'thing' 'tings' 'tlemen'
                'trans' 'tring' 'tts' 'uined' 'ulding' 'us'
                'ussels' 'utures' 'veling' 'vered' 'vering' 'vings'
                'vored' 'wanted' 'was' 'xas' 'ybody' 'yes'
                'ynes' 'ysics' 'zores'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
