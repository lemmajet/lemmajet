                'wicks' 'wields' 'willed' 'wilted' 'wits' 'witted'
                'wived' 'wkeyes' 'wkins' 'wles' 'wlines' 'wlocks'
                'wlogs' 'wnded' 'wnes' 'wning' 'wns' 'woes'
                'woking' 'wolds' 'worded' 'wplows' 'wps' 'wring'
                'wups' 'xans' 'xaxis' 'xerces' 'xerted' 'xerts'
                'xiated' 'xides' 'xists' 'xons' 'xpats' 'xports'
                'xuries' 'yads' 'yans' 'yarns' 'yars' 'yates'
                'ybills' 'ybirds' 'ycards' 'yces' 'yches' 'ycians'
                'yds' 'yeats' 'yees' 'ygars' 'ygone' 'ygons'
                'ygues' 'yhocks' 'yikes' 'ylated' 'ylaws' 'ylides'
                'ylites' 'ylized' 'ylons' 'yls' 'yments' 'ymers'
                'ymes' 'ymiest' 'ymized' 'ynds' 'ynes' 'ynews'
                'ynting' 'yoming' 'younge' 'yphics' 'yphs' 'yping'
                'ypops' 'ypted' 'yrds' 'yrians' 'ys' 'ysses'
                'ytes' 'ything' 'ythink' 'ytimes' 'yting' 'ytized'
                'ytopes' 'ytrons' 'yves' 'ywed' 'yworms' 'zales'
                'zals' 'zarded' 'zarks' 'zenry' 'zies' 'zins'
                'zits' 'zlers' 'zoans' 'zomes' 'zoning' 'zores'
                'zures'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
