                'acled' op_0_1 'acture' op_0_1 'actus' op_0_2 'aculty' op_0_1 'acuted' op_0_1 'addied' op_0_1
                'addle' op_0_1 'addles' op_0_2 'adiate' op_0_1 'adings' op_0_1 'adited' op_0_1 'adled' op_0_1
                'adman' op_0_2 'adore' op_0_1 'adsman' op_0_2 'aelis' op_0_1 'afest' op_0_2 'affled' op_0_2
                'agas' op_0_1 'agated' op_0_1 'agest' op_0_2 'agned' op_0_1 'aguest' op_0_2 'ahedra' op_0_1
                'aied' op_1_2 'aiety' op_0_1 'aigned' op_0_2 'ailman' op_0_2 'ailmen' op_0_2 'aily' op_0_1
                'ainest' op_0_3 'airer' op_0_2 'aised' op_0_2 'aitest' op_0_3 'akings' op_1_4 'alady' op_0_1
                'alamed' op_0_2 'alary' op_0_1 'alates' op_0_2 'aleman' op_0_2 'alied' op_0_1 'allege' op_0_1
                'allery' op_0_1 'alles' op_0_1 'allies' op_0_1 'alry' op_0_1 'alute' op_0_1 'alutes' op_0_2
                'amated' op_0_2 'amaze' op_0_1 'amed' op_0_1 'amily' op_0_1 'amines' op_0_2 'amity' op_0_1
                'ampler' op_0_1 'anage' op_0_1 'anages' op_0_2 'anary' op_0_1 'ancing' op_0_3 'andum' op_0_2
                'andums' op_0_3 'aner' op_1_2 'anest' op_1_3 'angest' op_0_2 'anings' op_1_4 'anise' op_0_1
