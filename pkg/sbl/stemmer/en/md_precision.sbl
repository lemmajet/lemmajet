                'utras' 'utures' 'uturing' 'uumed' 'uvered' 'uvering'
                'uvians' 'uzis' 'vacs' 'vadans' 'vailing' 'valled'
                'vanizes' 'vantest' 'vegging' 'vells' 'ventry' 'verates'
                'vestry' 'veted' 'vetians' 'vhs' 'vickers' 'vics'
                'vified' 'vify' 'viking' 'vilize' 'viners' 'vinny'
                'virons' 'vitals' 'vitated' 'vitors' 'vms' 'volutes'
                'vored' 'voring' 'vorings' 'vorting' 'vres' 'vros'
                'vrts' 'vskis' 'vules' 'waders' 'waggle' 'walters'
                'wanings' 'wanted' 'wantest' 'wanting' 'wappers' 'warf'
                'warning' 'watered' 'wdered' 'wdrifts' 'wdrops' 'weets'
                'welders' 'wended' 'wens' 'wfields' 'wgirls' 'whats'
                'whores' 'whupped' 'willed' 'willing' 'wilted' 'witted'
                'wived' 'wkeyes' 'wkins' 'wks' 'wles' 'wlocks'
                'wnded' 'wnes' 'woking' 'wolds' 'wombats' 'wonted'
                'wording' 'wpipes' 'wplows' 'wring' 'wstorms' 'wtowing'
                'wups' 'xacting' 'xampled' 'xatives' 'xerces' 'xhounds'
                'xiated' 'xisting' 'xos' 'xpats' 'xpended' 'xsports'
                'xtets' 'xties' 'xulting' 'yaching' 'yacting' 'yancy'
                'yapping' 'ybills' 'ybirds' 'yces' 'yches' 'yclades'
                'ycos' 'ydivers' 'ydiving' 'ydos' 'yds' 'yeading'
                'yemen' 'ygens' 'ygraphs' 'ygues' 'yhocks' 'yhooed'
                'yhose' 'yikes' 'yjacked' 'ylaws' 'ylized' 'ymakers'
                'ymiest' 'ymonds' 'ynes' 'ynews' 'yoming' 'younge'
                'yphs' 'yping' 'ypos' 'ypted' 'yrating' 'yrys'
                'ysics' 'ysses' 'ystacks' 'ytes' 'ything' 'ytics'
                'yting' 'ytopes' 'yves' 'yways' 'ywed' 'zales'
                'zaras' 'zarded' 'zinged' 'zingers' 'zits' 'zlers'
                'zomes' 'zoned' 'zoning' 'zores' 'zsimons'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
