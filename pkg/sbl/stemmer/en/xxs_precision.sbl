integers ( cutv )

booleans ( pfx_changed )

routines (
    exceptions
    strip_prefix
    strip_enclitics
    apply_suffix_trie
    normalize_tail
    op_0_1
    op_0_2
    op_0_3
    op_1_1
    op_1_2
    op_1_3
    op_1_4
    op_2_1
    op_2_2
    op_2_3
)

externals ( lemmatize stem )

backwardmode (
    /* Stage 1: Suppletive / Irregular Exceptions Lookup */
    define exceptions as (
        [substring] atlimit among (
  'arriv' (<- 'arrive')
  'complet' (<- 'complete')
  'date' (<- 'dat')
  'drive' (<- 'driv')
  'file' (<- 'fil')
  'give' (<- 'giv')
  'have' (<- 'ha')
  'his' (<- 'he')
  'men' (<- 'man')
  'our' (<- 'we')
  'produce' (<- 'produc')
  'provide' (<- 'provid')
  'range' (<- 'rang')
  'relat' (<- 'relate')
  'rule' (<- 'rul')
  'score' (<- 'scor')
  'serve' (<- 'serv')
  'share' (<- 'shar')
  'smile' (<- 'smil')
  'study' (<- 'stud')
  'their' (<- 'they')
  'trade' (<- 'trad')
  'vote' (<- 'vot')
  'was' (<- 'be')
  'your' (<- 'you')
        )
    )

    /* Stage 2b: Movable Enclitic Stripping */
    define strip_enclitics as (false)

    define op_0_1 as ($cutv = 1 set pfx_changed)
    define op_0_2 as ($cutv = 2 set pfx_changed)
    define op_0_3 as ($cutv = 3 set pfx_changed)
    define op_1_1 as (test next $cutv = 1 set pfx_changed)
    define op_1_2 as (test next $cutv = 2 set pfx_changed)
    define op_1_3 as (test next $cutv = 3 set pfx_changed)
    define op_1_4 as (test next $cutv = 4 set pfx_changed)
    define op_2_1 as (test hop 2 $cutv = 1 set pfx_changed)
    define op_2_2 as (test hop 2 $cutv = 2 set pfx_changed)
    define op_2_3 as (test hop 2 $cutv = 3 set pfx_changed)

    /* Stage 3: Pruned Reversed Suffix-Trie CutAdd Transducer */
    define apply_suffix_trie as (
        $cutv = 0
        (
            [ test substring hop cutv ] among (
                'abled' op_0_1 'amed' op_0_1 'aped' op_0_1 'ased' op_0_1 'asty' op_0_1 'asy' op_0_1
                'aved' op_0_1 'bbed' op_1_3 'bbing' op_1_4 'came' op_1_3 'cared' op_0_1 'cated' op_0_1
                'ced' op_0_1 'chman' op_0_2 'dary' op_0_1 'dded' op_1_3 'dding' op_1_4 'dest' op_1_3
                'done' op_0_2 'eamed' op_0_2 'ed' op_2_2 'eive' op_0_1 'elled' op_0_3 'erged' op_0_2
                'eved' op_0_1 'fy' op_1_1 'fying' op_1_4 'ged' op_0_1 'gged' op_1_3 'gging' op_1_4
                'gher' op_0_2 'gry' op_0_1 'hes' op_1_2 'hest' op_1_3 'iated' op_0_1 'ied' op_2_3
                'ies' op_2_3 'iety' op_0_1 'iked' op_0_1 'inced' op_0_2 'ing' op_2_3 'ired' op_0_1
                'ised' op_0_1 'itled' op_0_1 'iven' op_0_2 'kely' op_0_1 'kest' op_1_3 'lest' op_1_3
                'liest' op_1_4 'lined' op_0_1 'lize' op_0_1 'lude' op_0_1 'ludes' op_0_2 'lying' op_1_4
                'make' op_0_2 'mated' op_0_1 'mble' op_0_1 'mbles' op_0_2 'men' op_1_2 'mmed' op_1_3
                'mming' op_1_4 'move' op_0_1 'ncy' op_0_1 'nged' op_0_2 'ngest' op_0_3 'nited' op_0_1
                'nned' op_1_3 'nning' op_1_4 'nsity' op_0_1 'ntity' op_0_1 'nying' op_1_4 'oduce' op_0_1
                'oes' op_1_2 'okies' op_0_1 'orary' op_0_1 'ority' op_0_1 'osed' op_0_1 'oused' op_0_1
                'ouses' op_0_1 'owest' op_0_3 'paid' op_0_2 'pany' op_0_1 'pay' op_0_1 'pled' op_0_1
                'pped' op_1_3 'pping' op_1_4 'pply' op_0_1 'psed' op_0_1 'rgy' op_0_1 'rings' op_0_1
                'rized' op_0_1 'rred' op_1_3 'rring' op_1_4 'rry' op_0_1 'rying' op_1_4 's' op_2_1
                'sest' op_0_2 'sman' op_0_2 'sses' op_0_2 'test' op_1_3 'tood' op_1_3 'try' op_0_1
                'tted' op_1_3 'ttest' op_1_4 'tting' op_1_4 'uated' op_0_1 'ubled' op_0_1 'ucing' op_0_3
                'ued' op_0_1 'ured' op_0_1 'uses' op_0_2 'xes' op_1_2
                    (delete)
                'aging' op_0_3 'cing' op_0_3 'iring' op_0_3 'uing' op_0_3
                    (<- 'e')
                'iest' op_1_4
                    (<- 'y')
                'aired' 'aos' 'cbs' 'dited' 'dred' 'eaded'
                'ecies' 'ected' 'eed' 'ening' 'eping' 'erry'
                'etics' 'ffy' 'fing' 'fred' 'fried' 'gned'
                'hamas' 'ias' 'ings' 'is' 'jing' 'las'
                'lles' 'los' 'monds' 'mons' 'mpics' 'mrs'
                'news' 'nics' 'oured' 'rited' 'ss' 'stics'
                'thing' 'tring' 'urbed' 'us' 'vered' 'was'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
