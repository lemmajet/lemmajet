                '{u017e}inov{u00e9}' '{u017e}insk{u00e1}' '{u017e}istek' '{u017e}it{u011b}' '{u017e}ivn{u00e9}' '{u017e}i{u0161}t{u011b}'
                '{u017e}kala' '{u017e}kem' '{u017e}klo' '{u017e}kne' '{u017e}koval' '{u017e}kov{u00e1}'
                '{u017e}k{u00e1}{u0159}i' '{u017e}k{u016f}' '{u017e}li' '{u017e}luto' '{u017e}mem' '{u017e}m{u00e1}'
                '{u017e}nat{u00ed}' '{u017e}ninou' '{u017e}n{u00ed}{u010d}ku' '{u017e}n{u011b}li' '{u017e}o' '{u017e}odol'
                '{u017e}oldu' '{u017e}ou' '{u017e}ovit{u00e9}' '{u017e}ovsk{u00e1}' '{u017e}ov{u011b}l{u00e1}' '{u017e}ran{u00e9}'
                '{u017e}ran{u00ed}m' '{u017e}rati' '{u017e}rav{u00ed}' '{u017e}tky' '{u017e}t{u011b}' '{u017e}u'
                '{u017e}ulka' '{u017e}ulu' '{u017e}una' '{u017e}uno' '{u017e}unovi' '{u017e}urov{u00e1}'
                '{u017e}{u00e1}k{u016f}v' '{u017e}{u00e1}na' '{u017e}{u00e1}nci' '{u017e}{u00e1}ni' '{u017e}{u00e1}rnou' '{u017e}{u00e1}zan{u00e9}'
                '{u017e}{u00e9}{u0161}e' '{u017e}{u00ed}c{u00ed}ma' '{u017e}{u00ed}h{u00e1}' '{u017e}{u00ed}kovo' '{u017e}{u00ed}nku' '{u017e}{u00ed}nky'
                '{u017e}{u00ed}n{u00e1}' '{u017e}{u00ed}py' '{u017e}{u00ed}ra{u010d}i' '{u017e}{u00ed}rnou' '{u017e}{u00ed}rsk{u00fd}' '{u017e}{u00ed}r{u00e1}no'
                '{u017e}{u00ed}tka' '{u017e}{u00ed}tku' '{u017e}{u00ed}{u0161}sk{u00e1}' '{u017e}{u010f}ce' '{u017e}{u010f}ov{u00e9}' '{u017e}{u0161}t{u011b}l{u00e9}'
                '{u017e}{u0161}t{u011b}na' '{u017e}{u0161}{u00ed}ho' '{u017e}{u0161}{u00ed}mu' '{u017e}{u0161}{u0165}uje' '{u017e}{u016f}v'
                    ()
            )
        ) or (
            [ next ] has_3 (delete set pfx_changed)
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
