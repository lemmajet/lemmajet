                '{u017e}ickou' '{u017e}ick{u00e1}' '{u017e}id{u00e9}' '{u017e}ilami' '{u017e}il{u00e1}ch' '{u017e}itel{u016f}m'
                '{u017e}itn{u00fd}ch' '{u017e}ivoval' '{u017e}ivovat' '{u017e}iv{u00e9}mu' '{u017e}kostmi' '{u017e}nick{u00e1}'
                '{u017e}nostmi' '{u017e}n{u00ed}c{u00ed}ch' '{u017e}ofie' '{u017e}ovky' '{u017e}ov{u00e1}ni' '{u017e}ov{u00e1}no'
                '{u017e}ov{u00e1}ny' '{u017e}ravc{u016f}' '{u017e}ujete' '{u017e}uji' '{u017e}uj{u00ed}ce' '{u017e}{u00e1}d{u00e1}ni'
                '{u017e}{u00e1}k{u016f}m' '{u017e}{u00ed}vaje' '{u017e}{u00ed}vaj{u00ed}c' '{u017e}{u00ed}vej' '{u017e}{u00ed}v{u00e1}te' '{u017e}{u00ed}zniv{u00fd}'
                '{u017e}{u0148}uji'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
