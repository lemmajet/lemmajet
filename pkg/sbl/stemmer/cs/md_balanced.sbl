                'abku' op_0_1 'abla' op_0_1 'ablanky' op_0_2 'ableskla' op_0_2 'ableskne' op_0_2 'ablokuje' op_0_3
                'abloudit' op_0_1 'abloudiv' op_0_1 'ably' op_0_1 'abl{u00e9}ho' op_0_2 'abl{u00e9}mu' op_0_2 'abodnul' op_0_3
                'abola' op_0_1 'abonsk{u00e1}' op_0_1 'abor' op_0_1 'abotovat' op_0_4 'abouraj{u00ed}' op_0_2 'abov{u00e9}' op_1_3
                'abo{u010d}{u00ed}' op_0_1 'abranou' op_0_4 'abrav' op_0_1 'abra{u0148}me' op_0_3 'abru{u010d}el' op_0_1 'abru{u010d}eli' op_0_2
