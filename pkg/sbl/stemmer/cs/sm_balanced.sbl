                '{u017e}ichme' '{u017e}ie' '{u017e}iga' '{u017e}ikla' '{u017e}ik{u00e1}' '{u017e}il{u00e1}m'
                '{u017e}insk{u00e1}' '{u017e}it{u00ed}' '{u017e}it{u011b}' '{u017e}ivn{u00e9}' '{u017e}ivo' '{u017e}i{u0161}t{u011b}'
                '{u017e}kov{u00e1}' '{u017e}k{u016f}' '{u017e}li' '{u017e}luto' '{u017e}mem' '{u017e}m{u00e1}'
                '{u017e}n{u00ed}{u010d}ku' '{u017e}o' '{u017e}oldu' '{u017e}ou' '{u017e}ovsk{u00e1}' '{u017e}rav{u00ed}'
                '{u017e}tky' '{u017e}t{u011b}' '{u017e}u' '{u017e}ulka' '{u017e}ulu' '{u017e}una'
                '{u017e}uno' '{u017e}unovi' '{u017e}urov{u00e1}' '{u017e}{u00e1}k{u016f}v' '{u017e}{u00e1}na' '{u017e}{u00e1}ni'
                '{u017e}{u00e1}rnou' '{u017e}{u00e1}zan{u00e9}' '{u017e}{u00e9}{u0161}e' '{u017e}{u00ed}nku' '{u017e}{u00ed}nky' '{u017e}{u00ed}rnou'
                '{u017e}{u00ed}rsk{u00fd}' '{u017e}{u00ed}tka' '{u017e}{u0161}{u00ed}ho' '{u017e}{u0161}{u00ed}mu' '{u017e}{u016f}v'
                    ()
            )
        ) or (
            [ next ] has_3 (delete set pfx_changed)
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
