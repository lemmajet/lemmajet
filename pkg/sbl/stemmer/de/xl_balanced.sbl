                '{u00e4}ppelt' '{u00e4}quanten' '{u00e4}rfe' '{u00e4}rfenden' '{u00e4}rf{u00e4}higen' '{u00e4}rgers'
                '{u00e4}ringern' '{u00e4}rischem' '{u00e4}risches' '{u00e4}rkischen' '{u00e4}rkte' '{u00e4}rkten'
                '{u00e4}rschlag' '{u00e4}rst' '{u00e4}rtes' '{u00e4}rtigem' '{u00e4}rtiges' '{u00e4}rzte'
                '{u00e4}schert' '{u00e4}skriptiven' '{u00e4}sset' '{u00e4}therische' '{u00e4}tige' '{u00e4}tigen'
                '{u00e4}tiges' '{u00e4}ttern' '{u00e4}tteten' '{u00e4}tzigen' '{u00e4}ugnen' '{u00e4}ugnete'
                '{u00e4}ugt' '{u00e4}uschten' '{u00e4}yerischen' '{u00f6}beren' '{u00f6}blierten' '{u00f6}chleins'
                '{u00f6}chst' '{u00f6}ckelte' '{u00f6}ckern' '{u00f6}ders' '{u00f6}gte' '{u00f6}gten'
                '{u00f6}hern' '{u00f6}hle' '{u00f6}hlet' '{u00f6}hmens' '{u00f6}hnliches' '{u00f6}kologen'
                '{u00f6}liges' '{u00f6}llige' '{u00f6}lligem' '{u00f6}lliges' '{u00f6}lreichen' '{u00f6}mmt'
                '{u00f6}nert' '{u00f6}nige' '{u00f6}nniges' '{u00f6}nzureden' '{u00f6}rdens' '{u00f6}rerische'
                '{u00f6}rers' '{u00f6}richten' '{u00f6}rrt' '{u00f6}rtliche' '{u00f6}sbaren' '{u00f6}scht'
                '{u00f6}sischem' '{u00f6}sisches' '{u00f6}ssere' '{u00f6}ssern' '{u00f6}ssert' '{u00f6}sste'
                '{u00f6}ssten' '{u00f6}sster' '{u00f6}steln' '{u00f6}stelte' '{u00f6}stungen' '{u00f6}teln'
                '{u00f6}{u00df}licher' '{u00fc}bers' '{u00fc}chtern' '{u00fc}chtert' '{u00fc}ckert' '{u00fc}cklosen'
                '{u00fc}det' '{u00fc}disches' '{u00fc}ffendes' '{u00fc}gbaren' '{u00fc}gbarer' '{u00fc}gbares'
                '{u00fc}geleisen' '{u00fc}gels' '{u00fc}hern' '{u00fc}hlingen' '{u00fc}hrte' '{u00fc}ldene'
                '{u00fc}ldenen' '{u00fc}ltige' '{u00fc}ltigen' '{u00fc}ltiges' '{u00fc}mern' '{u00fc}mierten'
                '{u00fc}mpelte' '{u00fc}mpfe' '{u00fc}nchens' '{u00fc}ndlichen' '{u00fc}ndlicher' '{u00fc}ndnisse'
                '{u00fc}nken' '{u00fc}nkern' '{u00fc}nnige' '{u00fc}nnigen' '{u00fc}pfungen' '{u00fc}rbten'
                '{u00fc}rers' '{u00fc}rgert' '{u00fc}rget' '{u00fc}rgriff' '{u00fc}ringe' '{u00fc}rmerischen'
                '{u00fc}rteln' '{u00fc}rworte' '{u00fc}rzliche' '{u00fc}rzlichen' '{u00fc}rzter' '{u00fc}stelte'
                '{u00fc}sterte' '{u00fc}tert' '{u00fc}tierte' '{u00fc}ttelten' '{u00fc}ttet' '{u00fc}tzern'
                    ()
            )
        )
    )

    /* Stage 4: Stem-End Morphophonemic Tail Normalization */
    define normalize_tail as (false)
)

/* Stage 2a: Forward Prefix Stripping */
define strip_prefix as (false)

define lemmatize as (
    unset pfx_changed
    do strip_prefix
    backwards (
        ( not pfx_changed exceptions ) or (
            $(len >= 2)
            do strip_enclitics
            ( pfx_changed exceptions ) or (
                unset pfx_changed
                do apply_suffix_trie
                ( pfx_changed exceptions ) or do normalize_tail
            )
        )
    )
)

define stem as (lemmatize)
